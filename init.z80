; =====================================================================
;  init.z80 - ?init (arranque real: video + FULL_PAGING + duplicar el
;  switcher) + ?ldccp/?rlccp (de momento un STUB: no tenemos CCP3.ASM
;  ensamblado todavia, asi que en vez de cargar la CCP de verdad
;  imprimimos un mensaje y nos quedamos parados -- primer objetivo
;  real: llegar hasta aqui en hardware real).
;
;  ?init se llama UNA vez desde BIOSKRNL.ASM (boot:), DESPUES del bucle
;  de ?cinit (16 veces, no-op para nosotros) y ANTES del bucle de INIT
;  de disco (sd_init/ram_init, tambien no-op) -- osea, nada depende de
;  que el video este listo antes de que esta rutina lo deje listo.
;
;  Secuencia de video: identica a boot_cpm.asm/banktest.asm, ya
;  validada en hardware real. La leccion de banktest.asm sobre copiar la
;  fuente de la ROM ANTES de remapear los bloques 0-2 (si no, $1E00 deja
;  de ser la ROM real y la copia sale en blanco) ya no aplica: la fuente
;  real de 256 caracteres se ensambla directamente en su sitio
;  (font_image.z80, $F800) y el cargador la deja puesta -- aqui solo
;  queda apuntar el registro I.
; =====================================================================

;            public ?init,?ldccp,?rlccp
;            extrn  ?pmsg

DFILE_OVR      equ 2096
DFILE_OVR_EN   equ 2098
; CPM3_SD81: DFILE/ATTR empaquetados (antes $EA00/$E200, alineados a 2 KB
; por costumbre, no por necesidad). El FPGA no impone NINGUNA alineacion:
; con el override activo calcula "char_addr_80 = DFILE_eff+1+fila+col" y
; "attr_addr_m1 = ATTR_BASE_OVERRIDE+1+..." con sumadores de 16 bits
; completos (SD81.v:1048/1070, el comentario del propio Verilog lo dice:
; "base COMPLETAMENTE independiente, direccion de 16 bits sin truncar ni
; forzar el bit 15"). Cada buffer ocupa 1+24*81 = 1945 bytes reales, asi
; que los slots de 2048 desperdiciaban 104 bytes cada uno, y el SCB (256
; bytes exactos, hasta bdosadd = scb$pg+0FEh) dejaba otros 256 sin usar
; entre $E100 y $E200. Recuperados para meter RESBDOS.ASM en el banco 7
; -- ver memory_map.md.
DFILE_val      equ 0E899h
ATTR_OVR       equ 2059
ATTR_OVR_EN    equ 2061
ATTR_val       equ 0E100h
FONT_I         equ 0F8h
FONT_ADDR      equ 0F800h        ; la tabla la genera font_image.z80

ROWS           equ 24
COLS           equ 80

DataPort       equ 0A7h
ClkPort        equ 0AFh
CMD_chars256   equ 041h        ; SEL_256CHARS = 65
CMD_fullpaging equ 01Dh        ; 29

;            extrn  dup_switcher

?init:      di
            xor  a
            out  (0FDh), a       ; NMI off

            ; --- vectores de redireccion de E/S (SCB.ASM): sin esto
            ; quedan a 0/basura y conout/conin (BIOSKRNL.ASM, out$scan/
            ; in$scan) escanean sus 16 bits llamando a ?ci/?co una vez
            ; por cada bit a 1 -- con @ctbl teniendo un unico dispositivo
            ; (bit15, el primero que prueba el escaneo), hace falta
            ; $8000 exacto para seleccionar SOLO el dispositivo 0. Sin
            ; inicializar esto se ve cada caracter repetido/arrastrado
            ; (una llamada a ?co por cada bit a 1 que haya quedado).
            ld   hl, 08000h
            ld   (@CIVEC), hl
            ld   (@COVEC), hl
            ld   (@AIVEC), hl
            ld   (@AOVEC), hl
            ld   (@LOVEC), hl

            ; @MXTPA: "top of user TPA", pero tambien la direccion real
            ; de entrada a la BDOS -- set$jumps (BIOSKRNL.ASM) la lee
            ; para montar el vector de la direccion 5 ("call 5") en
            ; cada arranque/entrada a la CCP. NO apunta directamente a
            ; "bdos" (RESBDOS.ASM, memoria de sistema): confirmado en
            ; hardware que un programa de usuario haciendo "call 5"
            ; llega ahi con "usuario" TODAVIA activo (nadie cambio de
            ; banco aun en ese momento) -- mismo bug que boot$1/
            ; ldccp_real, aqui en el punto mas fundamental de todos.
            ; call5_entry (banco 7, ver mas abajo) hace el cambio a
            ; sistema primero.
            ld   hl, call5_entry
            ld   (@MXTPA), hl

            ; --- vector de error del SCB ($E0FB) ---
            ; En un CP/M+ real esta ranura la rellena GENSYS, el generador
            ; de sistema de DRI, con un "jmp error$sub". Lo dice el propio
            ; comentario de BDOS.ASM: "error$sub is referenced indirectly
            ; by the SCB ERROR field in RESBDOS ... This value is converted
            ; to the actual address of error$sub BY GENSYS". Como nosotros
            ; no pasamos por GENSYS, hay que ponerlo a mano o queda a
            ; ceros -- y entonces el primer error de la BDOS (p.ej. un
            ; "Invalid Drive", que es justo lo que pasa mientras no haya
            ; unidades reales) hace "call error" contra $E0FB, cae por los
            ; NOPs del final del SCB y sigue ejecutando los atributos y la
            ; pantalla como si fueran codigo. Confirmado en hardware.
            ;
            ; Se usa ?ERJMP (SCB.ASM, incluido ANTES que este fichero) y
            ; no el simbolo "error" de BDOS.ASM, que se incluye despues:
            ; las referencias adelantadas a equ ya nos han desestabilizado
            ; el ensamblado otras veces. Con la base del SCB corregida,
            ; ?ERJMP y "error" son la misma direccion ($E0FB).
            ld   a, 0C3h         ; opcode de JMP
            ld   (?ERJMP), a
            ld   hl, error$sub
            ld   (?ERJMP+1), hl

            ; --- @BNKBF: el campo del SCB es un PUNTERO al buffer de 128
            ; bytes del BIOS bancado, no el buffer. Nuestro codigo usa el
            ; simbolo @BNKBF como el buffer en si (ver SCB.ASM), asi que
            ; aqui se deja ademas la direccion en la ranura que le
            ; corresponde, por si alguna parte de la BDOS la consulta.
            ld   hl, @BNKBF
            ld   (scb$base+35h), hl

            ; --- campos del SCB que rellena GENSYS ---
            ; Mismo caso que el vector de error de arriba: en un CP/M+
            ; real los deja puestos el generador de sistema, y nosotros
            ; no pasamos por el.
            ;
            ; scb$base+3Ah ("system control block address") es el que la
            ; CCP pide con la funcion 49 nada mas arrancar y guarda en
            ; "scbaddr". A partir de ahi lee TODOS los campos del SCB con
            ; el patron "mvi l,offset / mov a,m", o sea usando solo la
            ; parte ALTA de ese valor como pagina. Con el campo a ceros se
            ; quedaba con H=$00 y leia la pagina cero en vez del SCB.
            ; Confirmado en hardware: metia el $FF de $00EC en el byte de
            ; unidad de su FCB de $$$.SUB (deberia haber leido temp$drive
            ; en $E0EC), y de ahi la unidad absurda del mensaje de error.
            ld   hl, scb$base
            ld   (scb$base+3Ah), hl

            ; Geometria de consola. La CCP la lee al arrancar para
            ; calcular columnas del catalogo y tamano de pagina:
            ;   dircols = (conwidth+1)/16   -> conwidth es 0-relativo
            ;   pgsize  = conpage-1
            ld   a, COLS-1
            ld   (scb$base+1Ah), a       ; conwidth  ($E0B6)
            ld   a, ROWS
            ld   (scb$base+1Ch), a       ; conpage   ($E0B8)

            ; commonbase ($E0F9): direccion donde empieza la memoria
            ; comun. La CCP se queda con su byte ALTO en su variable
            ; "banked" (start: "mvi l,com$base+1 / mov a,m / sta banked"),
            ; asi que con el campo a cero cree que el sistema NO es
            ; bancado. Aqui la zona comun es el banco 7, $E000.
            ld   hl, 0E000h
            ld   (scb$base+5Dh), hl      ; commonbase ($E0F9)

            ; rubout$act ($E0CB) = $FF: que DEL borre de verdad.
            ; La BDOS decide asi (BDOS.ASM, editor de linea de la func 10):
            ;   cpi rubout / LDA RUBOUT$ACT / INR A / JZ DO$CTLH
            ; o sea con $FF trata el $7F como retroceso y BORRA; con
            ; cualquier otro valor hace el "rubout" clasico de teletipo,
            ; que IMPRIME el caracter que borra -- correcto en papel
            ; continuo, absurdo en pantalla. Confirmado en hardware: con
            ; el campo a cero, SHIFT+0 mostraba el caracter a borrar.
            ; ctlh$act ($E0CA) se queda a 0, que es justo lo contrario y
            ; es lo que queremos: Ctrl-H hace un retroceso normal.
            ld   a, 0FFh
            ld   (scb$base+2Fh), a       ; rubout$act ($E0CB)

            ; Fuente: la tabla real de 256 caracteres ya esta en $F800,
            ; ensamblada en su sitio (font_image.z80) y puesta ahi por el
            ; propio cargador -- no hay nada que copiar. Aqui solo hace
            ; falta decirle al hardware donde esta, que en el ZX81 es el
            ; registro I (la FPGA lo captura en el refresco: "if (~nRFSH)
            ; ROMTABLE[15:8] = Addr[15:8]", SD81.v:456).
            ld   a, FONT_I
            ld   i, a

            ; secuencia de video real de boot_cpm.asm (ya validada en hardware)
            ld   a, (8 << 3)  | 0
            out  (0E7h), a
            ld   a, (9 << 3)  | 1
            out  (0E7h), a
            ld   a, (10 << 3) | 2
            out  (0E7h), a

            ld   hl, DFILE_val
            ld   (DFILE_OVR), hl
            ld   a, 170
            ld   (DFILE_OVR_EN), a

            ld   hl, ATTR_val
            ld   (ATTR_OVR), hl
            ld   a, 170
            ld   (ATTR_OVR_EN), a

            ld   a, 174
            ld   (2045), a

            xor  a
            ld   (2094), a
            ld   (2095), a

            ; --- mc45_ext67: por defecto MC45 solo cubre los bloques
            ; 4/5 (para no romper el salto nativo del BASIC en ROM a
            ; DFILE+$8000, que sigue existiendo incluso en modo FAST) --
            ; los bloques 6/7 (donde vive nuestro codigo en banco 7,
            ; $E000-$FFFF: boot$1/set$jumps/bnksel/@cbnk, ver bank.z80/
            ; BIOSKRNL.ASM) necesitan activarlo aparte.
            ld   a, 170
            ld   (2062), a       ; activar mc45_ext67 (bancos 6/7)

            xor  a               ; restaurar A=0 (lo pisamos arriba)
            ld   (2056), a      ; desproteger bloque 0 + cerrar ventana MMIO

            ld   a, CMD_chars256
            call in_mcu_send

            call in_clear_screen
            call in_clear_attrs

            ; --- activar FULL_PAGING antes de tocar ?bank/map1blk ---
            ld   a, CMD_fullpaging
            call in_mcu_send

            ; --- duplicar el switcher (bank.z80) en la pagina de usuario ---
            call dup_switcher

            ; --- rellenar la pagina 0 con HALT (ayuda de diagnostico) ---
            ; Bajo "sistema", ?bank mapea BANK0_BASE+bloque, o sea la
            ; pagina 0 en el bloque 0 -- y la pagina 0 es la ROM del ZX81.
            ; Eso hacia que cualquier salto perdido a memoria baja acabara
            ; EJECUTANDO la ROM, que sigue viva y se queda en su bucle de
            ; teclado: el fallo se disfrazaba de "se ha colgado" en vez de
            ; parar donde se produjo. Rellenandola de $76 (HALT) la CPU
            ; para en seco y el depurador da la direccion exacta.
            ;
            ; Hay que hacerlo por ventana temporal: a estas alturas el
            ; bloque 0 ya tiene la pagina 8 (ver arriba), asi que no vale
            ; escribir directamente en $0000. Se usa el bloque 6 porque a
            ; estas alturas nadie lee todavia lo que hay ahi (parte de la
            ; imagen de la CCP), y se restaura al salir.
            ld   a, 0            ; pagina 0 (la ROM)
            ld   e, 6            ; ventana: bloque 6 ($C000-$DFFF)
            call map1blk
            ld   hl, 0C000h
            ld   (hl), 076h      ; HALT
            ld   de, 0C001h
            ld   bc, 8191
            ldir
            ld   a, BANK0_BASE+6 ; restaurar la pagina de sistema
            ld   e, 6
            call map1blk

            ; --- senal de vida: mensaje en pantalla ---
            ld   hl, signon_msg
            call ?pmsg

            ret                  ; BIOSKRNL sigue con el bucle de INIT de disco
                                 ; (interrupciones deshabilitadas todo el
                                 ; rato, igual que boot_cpm.asm/banktest.asm)

; ---------------------------------------------------------------------
; in_mcu_send - protocolo MCU de bajo nivel (igual que en banktest.asm)
; ---------------------------------------------------------------------
in_mcu_send:
            ld   b,a
            in   a,(ClkPort)
            ld   c,a
            ld   a,b
            out  (DataPort),a
            ld   a,c
            cpl
            ld   c,a
ims_wait:   in   a,(ClkPort)
            xor  c
            jp   m, ims_wait
            ret

; ---------------------------------------------------------------------
; in_clear_screen / in_clear_attrs - pantalla a espacios, atributos a
; tinta blanca/papel negro (nibble alto=papel, nibble bajo=tinta, ver
; DOC/superfast_wide_text_modes.md #5 -- NO el formato 3+3 estilo
; Spectrum).
; ---------------------------------------------------------------------
in_clear_screen:
            ld   hl, DFILE_val+1
            ld   b, ROWS
ics_row:    push bc
            ld   c, COLS
            ; codigo 32 (espacio ASCII), no 0: coincide con "cls"
            ; (chario.z80) y con la fuente ASCII que se cargara desde SD.
            ; Ademas deja libres los 256 bytes de la tabla de fuentes que
            ; corresponden a los codigos 0-31 (nunca imprimibles: ?co los
            ; filtra con "cp 20h / ret c"), como reserva de memoria comun
            ; -- ver memory_map.md.
            ld   a, 32
ics_col:    ld   (hl), a
            inc  hl
            dec  c
            jr   nz, ics_col
            ld   (hl), 0
            inc  hl
            pop  bc
            djnz ics_row
            ret

in_clear_attrs:
            ld   hl, ATTR_val+1
            ld   b, ROWS
ica_row:    push bc
            ld   c, COLS
            ld   a, 0Fh
ica_col:    ld   (hl), a
            inc  hl
            dec  c
            jr   nz, ica_col
            ld   (hl), 0
            inc  hl
            pop  bc
            djnz ica_row
            ret

; Mensajes de prueba, terminados en 0 (la convencion de ?pmsg -- NO el
; $FF que usa el print_msg directo de banktest.asm).
;
; Ahora en ASCII normal: la fuente ya no es la ROM del ZX81 en su orden
; nativo, sino la tabla ASCII/CP437 de font_image.z80. Antes iban como
; codigos ZX81 ("INIT" = 46,51,46,57) y con la restriccion de usar SOLO
; letras, porque los digitos del ZX81 (28-37) y su espacio caen por
; debajo de $20 y ?co los tomaba por codigos de control. Eso se acabo:
; ya se puede escribir cualquier texto imprimible tal cual.
signon_msg: defb 'INIT', 0
noccp_msg:  defb 'NOCCP', 0

; =======================================================================
;  ldccp_real - banco 7 ($F704, hueco libre justo detras del bloque
;  comun de BIOSKRNL.ASM; antes en $F400, movido al empaquetar el banco
;  7 para hacerle sitio a RESBDOS.ASM). Bug real encontrado en
;  hardware con trazado paso a paso: esta rutina cambia de contexto
;  (sistema/usuario) VARIAS veces DURANTE su propia ejecucion (igual
;  que boot$1/set$jumps/bnksel, ver bank.z80) -- viviendo en banco 4
;  normal (donde estaba antes, junto al resto de ?init), en cuanto hace
;  el primer "call bnksel" con A=1 (usuario), la propia direccion
;  siguiente de esta rutina deja de tener nuestro codigo (la pagina de
;  usuario nunca lo tuvo cargado) -> ejecucion de basura (PC acababa
;  leyendo $FF = RST 38h de la pagina de usuario, sin inicializar). El
;  banco 7 no necesita duplicacion (a diferencia de $7E00-$7FFF): nunca
;  lo toca "?bank", así que basta con vivir aqui, sin trucos.
; =======================================================================

init$cseg$save equ $          ; ver el "org" de cierre al final del fichero

            org  0F704h

; ---------------------------------------------------------------------
; ldccp_real - copia ccp$image (CCP3.ASM ya ensamblada, incrustada como
; datos en ccp_image.z80, ver ahi) a la TPA de usuario ($100) y vuelve.
; Llamado desde ?ldccp/?rlccp en bank.z80 (zona duplicada) -- boot$1 en
; BIOSKRNL.ASM hace "call ?ldccp" DIRECTAMENTE, sin pasar por la tabla
; de saltos; el propio ?ldccp (bank.z80: "xor a/call bnksel/jmp
; ldccp_real") YA deja "sistema" activo antes de llegar aqui -- no
; "usuario" (aunque asi estuviera justo antes, por set$jumps). Por eso
; el primer OUT no hace falta -- ccp$image (banco 0-6 sistema) ya es
; alcanzable de entrada.
;
; ccp$image esta en memoria de sistema (bancos 0-6), la TPA destino en
; memoria de usuario -- nunca alcanzables a la vez, asi que cada bloque
; de 128 B pasa por @bnkbf (banco 7, comun, ver diskio.z80/move.z80
; para el mismo patron con disco RAM/SD). "bnksel" (no "?bank" a secas)
; para mantener @cbnk sincronizado, igual que en toda la tabla de
; saltos -- ver bank.z80.
; ---------------------------------------------------------------------
ldccp_real: ld   hl, ccp$image
            ld   (ldc$src), hl
            ld   hl, 0100h
            ld   (ldc$dst), hl
            ld   a, ccp$image$padlen/128
            ld   (ldc$cnt), a

ldc$loop:   ; sistema activo aqui (al entrar, y al final de cada vuelta)
            ld   hl, (ldc$src)
            ld   de, @bnkbf
            ld   bc, 128
            ldir
            ld   hl, (ldc$src)
            ld   de, 128
            add  hl, de
            ld   (ldc$src), hl

            ld   a, 1
            call bnksel          ; usuario activo

            ld   hl, @bnkbf
            ld   de, (ldc$dst)
            ld   bc, 128
            ldir
            ld   hl, (ldc$dst)
            ld   de, 128
            add  hl, de
            ld   (ldc$dst), hl

            xor  a
            call bnksel          ; sistema activo otra vez, para la
                                 ; siguiente vuelta (o para el "ret" si
                                 ; esta era la ultima -- boot$1 hace
                                 ; "jmp ccp" justo despues, hace falta
                                 ; "usuario" activo entonces)

            ld   a, (ldc$cnt)
            dec  a
            ld   (ldc$cnt), a
            jr   nz, ldc$loop

            ld   a, 1
            call bnksel          ; usuario activo para "jmp ccp"
            ret

; ---------------------------------------------------------------------
; call5_entry - a esto apunta @MXTPA (arriba), o sea es el destino del
; "call 5" de cualquier programa de usuario.
;
; NO cambia de banco, a proposito. Antes hacia "xor a / call bnksel"
; para seleccionar sistema, y era obligatorio porque "bdos:" vivia en
; memoria banked de sistema. Con RESBDOS.ASM entero en el banco 7
; (comun) eso ya no hace falta, y ademas ROMPE el diseño de DRI: la
; BDOS residente se entra con el banco de USUARIO todavia puesto.
;
; Tiene que ser asi porque casi todo lo que hace este modulo antes de
; llamar a bank$bdos se refiere a memoria del usuario:
;   - "dad sp / shld rb$entsp" guarda el SP de la CCP, y rb$goback lo
;     restaura con "sphl / ret" -- leer ahi con "sistema" activo saca
;     la ROM del ZX81 en vez de la pila de la CCP (confirmado en
;     hardware: el ret sacaba $7E09, que son bytes de la ROM en $0C18).
;   - disk$function copia el FCB y el DMA "from the user bank to common
;     memory" (comentario del propio DRI) -- con sistema activo estaria
;     copiando memoria equivocada.
;
; El unico que cambia a sistema es bank$bdos, para ejecutar la parte
; bancada de la BDOS, y vuelve a usuario el solo antes de devolver el
; control ("mvi a,1 / jmp selmemf").
; ---------------------------------------------------------------------
call5_entry:
            jmp  bdos

; ---------------------------------------------------------------------
; lstack - pila propia de la BDOS (RESBDOS.ASM hace "lxi sp,lstack" al
; entrar en "bdos:"). Vivia en banco 5 (memoria de sistema normal,
; $BC6B) -- cualquier cambio de contexto que ocurriera MIENTRAS SP
; apuntaba ahi (p.ej. qconinx, que activa "usuario" un instante para
; leer un byte del programa de usuario) corrompia lo que se leyera
; despues de un push. Confirmado en hardware con trazado paso a paso.
; Banco 7: mismo motivo que @bnkbf (SCB.ASM) -- siempre la misma
; memoria fisica, pase lo que pase con ?bank.
; ---------------------------------------------------------------------
; ssize (RESBDOS.ASM) = 30, *2 = 60 -- valor literal aqui para no
; redefinir "ssize" (ya existe en RESBDOS.ASM, aunque haya dejado de
; usarse ahi) y evitar un "Mult. def."
            ds   60
lstack:

ldc$src:    ds   2
ldc$dst:    ds   2
ldc$cnt:    ds   1

; CPM3_SD81: guarda de tamano -- el siguiente bloque del banco 7 son las
; variables de ?bank (bank.z80, $F7A4). Si este se pasara, lo pisaria en
; silencio; con esto el "ds" sale negativo y el ensamblado falla.

            ds   0F7A4h-$

; =====================================================================
;  FIN del bloque del banco 7. Vuelta a memoria normal.
;
;  CPM3_SD81: este "org" de cierre FALTABA, y es el mismo descuido que
;  el de bank.z80 (ver alli). init.z80 es el ultimo fichero del XIOS,
;  asi que sin esto el contador de posicion se quedaba en $F7A4 al
;  terminar -- y la guarda de system.z80 ("ds 08A00h-$", justo detras
;  del include) comparaba contra $F7A4 en vez de contra el final real
;  del XIOS, dando siempre un "Value error" enganoso.
;
;  Aqui no hay nada detras dentro de este fichero, pero el contador de
;  posicion es global al ensamblado: hay que dejarlo donde estaba.
; =====================================================================

            org  init$cseg$save
