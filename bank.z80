; =====================================================================
;  bank.z80 - Todo lo que necesita vivir duplicado al final del banco 3
;  ($7E00-$7FFF, en la pagina 3 -sistema- y la 11 -usuario-, mismo
;  offset): ?bank, map1blk, y la tabla de saltos del BIOS (?boot/?wboot/
;  ?const/.../?xmov -- movida aqui desde BIOSKRNL.ASM).
;
;  Dos razones distintas para necesitar la duplicacion, no una:
;   1) ?bank es el UNICO codigo cuyo propio "ret" se ejecuta justo
;      DESPUES de haber cambiado el banco 3 bajo sus pies -- asi lo usa
;      BIOSKRNL.ASM (bnksel: sta @cbnk / jmp ?bank, un salto de cola: el
;      "ret" final de ?bank vuelve directamente al programa de usuario
;      cuando el contexto activo ya es "usuario").
;   2) La tabla de saltos del BIOS la llaman DIRECTAMENTE programas de
;      usuario reales (WordStar, Turbo Pascal...), sin pasar por BDOS,
;      para ganar velocidad en consola -- y esas llamadas ocurren con
;      "usuario" ya activo. Cada entrada hace "seleccionar sistema,
;      saltar a la rutina real" (la rutina real se queda en
;      BIOSKRNL.ASM, sin duplicar, porque una vez seleccionado sistema
;      ya no hace falta).
;
;  ?xmove/?move/sd_read/write/ram_read/write NO necesitan nada de esto:
;  solo se invocan DESDE BDOS (que ya esta en "sistema" cuando llama) y
;  siempre restauran el contexto original antes de su propio "ret", asi
;  que viven en zona normal (move.z80/diskio.z80), no aqui.
;
;  map1blk va aqui tambien porque es la MISMA primitiva de bajo nivel
;  (un OUT (C),A) que ?bank, y conviene que este siempre alcanzable sin
;  depender de que contexto este activo.
;
;  Ver memory_map.md para el mapa de paginas fisicas completo.
; =====================================================================

;            public ?bank,map1blk,dup_switcher
            include "memmap.inc"

; ---------------------------------------------------------------------
;  bank$savesp/bank$stack -- pila temporal de ?bank (ver la nota junto
;  a ?bank, mas abajo). Declarado AQUI (banco 7, $F7A4 -- antes $F600,
;  movido al empaquetar el banco 7 para RESBDOS.ASM) y no al final
;  del fichero a proposito -- referenciado hacia delante desde ?bank
;  desestabilizaba el ensamblado en varias pasadas (mismo sintoma que
;  el "bdose2" de BDOS.ASM: nada relacionado a simple vista dejaba de
;  funcionar -- aqui, ni siquiera se llegaba a entrar en ?bank).
;  "org 062E9h" al final para retomar la secuencia normal del fichero
;  (dup_switcher etc.) exactamente donde continuaria si este bloque no
;  existiera -- direccion confirmada en el .lst de antes de este bug.
; ---------------------------------------------------------------------
            org  0F7A4h

bank$retaddr: ds 2               ; direccion de retorno real del
                                  ; llamante, leida antes de reprogramar
                                  ; nada (ver la nota junto a ?bank)
bank$savesp: ds  2
bank$savehl: ds  2               ; HL del llamante (ver la nota en ?mov)
xmv$pend:   ds   1               ; <>0: hay un ?xmove pendiente. EN BANCO 7
                                  ; a proposito: lo escribe ?xmove bajo
                                  ; sistema y lo lee ?mov bajo el banco del
                                  ; llamante, asi que tiene que ser comun.
            ds   13              ; 6 niveles de push -- de sobra (?bank
                                  ; solo usa 4: af/bc/de + el bc interno
                                  ; del bucle)
bank$stack:                      ; tope de la pila; crece hacia abajo (el
                                  ; push decrementa SP ANTES de escribir),
                                  ; asi que en esta direccion no se escribe
                                  ; nunca. Los 16 bytes utiles quedan justo
                                  ; debajo. Para ampliarla, agrandar el "ds"
                                  ; de arriba -- NO mover esta etiqueta.

; CPM3_SD81: guarda de tamano -- detras viene dfctbl/xdfctbl
; (RESBDOS.ASM, org 0F7B8h). Antes esta guarda rellenaba hasta $F800 y
; por tanto SOLAPABA esas tablas; funcionaba de milagro, porque
; RESBDOS.ASM se ensambla despues y sus bytes ganaban. Dos "org" que se
; pisan no dan ningun error.

            ds   0F7B8h-$

; ---------------------------------------------------------------------
;  Estado del envoltorio biosw (ver mas abajo, junto a la tabla).
;
;  Tiene que estar en banco 7: se escribe a un lado de un cambio de banco
;  y se lee al otro. Va sobre los glifos 16-20 de la tabla de fuentes
;  ($F880-$F8A7), que no son imprimibles nunca (?co filtra todo lo que
;  esta por debajo de $20) -- por eso genfont.py empieza a emitir en el
;  codigo 21. Es la "reserva" del banco 7 que ya teniamos apuntada.
; ---------------------------------------------------------------------
            org  0F880h

bw$sp:      ds   2               ; SP del llamante
bw$hl:      ds   2               ; rutina real a la que hay que saltar
bw$bnk:     ds   1               ; banco del llamante, para restaurarlo
bw$a:       ds   1               ; valor devuelto en A
            ds   32              ; 16 niveles -- la rutina real (conout ->
                                  ; out$scan -> coster -> ?co ...) anida
                                  ; bastante mas que ?bank
bw$stack:                        ; tope; crece hacia abajo, aqui no se
                                  ; escribe nunca (igual que bank$stack)

; ---------------------------------------------------------------------
;  bank$exit - salida de ?bank. Restaura el HL del llamante y salta a su
;  direccion de retorno.
;
;  Vive en banco 7 y NO en la zona duplicada porque se automodifica: el
;  destino del "jp" se escribe justo antes de ejecutarlo. En la zona
;  duplicada eso seria inseguro (hay dos copias y ?bank cambia de banco a
;  mitad de su ejecucion, asi que podria modificarse una y ejecutarse la
;  otra). En banco 7 hay una sola copia y nunca se repagina.
;
;  Se llega aqui con el cambio de banco YA hecho, asi que no se toca la
;  pila del llamante -- que es el motivo por el que ?bank usaba "jp (hl)"
;  en vez de un "ret" y por el que no se puede simplemente hacer push.
; ---------------------------------------------------------------------
bank$exit:  ld   hl,(bank$retaddr)
            ld   (bank$jp+1),hl
            ld   hl,(bank$savehl)
bank$jp:    jp   0000h           ; automodificado, ver arriba

            ds   0F8B8h-$        ; guarda: detras empieza la fuente (cod 23)

            org  062E9h

; ---------------------------------------------------------------------
;  Tabla de saltos del BIOS -- movida aqui desde BIOSKRNL.ASM (ver la
;  nota en ese fichero). Duplicada al final del banco 3 junto con
;  ?bank/map1blk porque programas de usuario reales llaman a estas
;  entradas DIRECTAMENTE (sin pasar por BDOS) con "usuario" activo.
;  Hay tres formas de entrada, segun quien llame y que necesite:
;
;   a) E/S de caracter (?const/?conin/?cono/?list/?auxo/?auxi/?conos/
;      ?auxis/?auxos/?lists): "ld hl,rutina / jmp biosw". El envoltorio
;      cambia a sistema, LLAMA a la rutina y RESTAURA el banco del
;      llamante antes de volver, de modo que una llamada al BIOS no
;      altera el banco visible. Ver la nota larga junto a biosw.
;
;   b) Disco (?home/?sldsk/?sttrk/?stsec/?stdma/?read/?write/?sctrn...):
;      "xor a / call bnksel / jmp rutina", el salto de cola de siempre.
;      No hace falta restaurar: las llama la BDOS bancada, que ya esta
;      en sistema. Y ?sldsk/?sctrn DEVUELVEN valor en HL, que el
;      envoltorio usa para saber a donde saltar.
;
;   c) ?mov y ?xmov usan "call ?bank" en vez de "call bnksel", a
;      proposito, para que @cbnk conserve el banco del llamante y ?move
;      pueda restaurarlo -- ver la nota junto a ?mov. (El resto sigue
;      usando bnksel, que ademas de reprogramar el hardware actualiza
;      @cbnk.)
;
;  ?boot es la excepcion restante: se ejecuta una sola vez, al arrancar,
;  antes de que FULL_PAGING este activo; forzar un cambio de contexto
;  ahi seria prematuro. El cuerpo real va mas abajo, DESPUES de "org
;  SWITCHER_BASE" -- tiene que quedar duplicado tambien.
; ---------------------------------------------------------------------
;            public ?boot,?wboot,?const,?conin,?cono,?list,?auxo,?auxi
;            public ?home,?sldsk,?sttrk,?stsec,?stdma,?read,?write
;            public ?lists,?sctrn
;            public ?conos,?auxis,?auxos,?dvtbl,?devin,?drtbl
;            public ?mltio,?flush,?mov,?tim,?bnksl,?stbnk,?xmov
;            extrn  bnksel
;            extrn  boot,wboot,const,conin,conout,list,auxout,auxin
;            extrn  home,seldsk,settrk,setsec,setdma,read,write
;            extrn  listst,sectrn
;            extrn  conost,auxist,auxost,devtbl,getdrv
;            extrn  multio,flush,setbnk
;            extrn  ?cinit,?move,?xmove,?time

DUPWIN      equ 5              ; banco usado como ventana para duplicar
                                ; este modulo en el arranque

SWITCHER_BASE equ 07E00h       ; banco 3, ultimos 512 B ($7E00-$7FFF)
SWITCHER_LEN  equ 0200h
BANK3_ADDR    equ 06000h
SWITCHER_OFF  equ SWITCHER_BASE-BANK3_ADDR
DUPWIN_ADDR   equ 0A000h

; ---------------------------------------------------------------------
; dup_switcher - copia este modulo (ya cargado en la pagina de sistema,
; la 3) a la pagina de usuario (11), mismo offset dentro de la pagina.
; Llamar UNA vez en el arranque, antes de que nada intente ejecutar
; ?bank estando en contexto usuario. No necesita vivir en la zona
; duplicada: solo se llama una vez, con "sistema" siempre activo.
; ---------------------------------------------------------------------
dup_switcher:
            ld   a, BANK1_BASE+3
            ld   e, DUPWIN
            call map1blk
            ld   hl, SWITCHER_BASE
            ld   de, DUPWIN_ADDR+SWITCHER_OFF
            ld   bc, SWITCHER_LEN
            ldir
            ld   a, BANK0_BASE+DUPWIN
            ld   e, DUPWIN
            call map1blk
            ret

; =======================================================================
;  Zona duplicada -- banco 3, $7E00-$7FFF. Todo lo de aqui abajo se
;  copia tambien a la pagina de usuario por dup_switcher, arriba.
; =======================================================================

            org  SWITCHER_BASE

; ---------------------------------------------------------------------
; map1blk - mapea la pagina A en el banco E (0-7). No toca @cbnk ni el
; resto de bancos.
; ---------------------------------------------------------------------
map1blk:    push bc
            ld   b,a
            ld   c,0E7h
            ld   a,e
            out  (c),a
            pop  bc
            ret

; ---------------------------------------------------------------------
; ?bank - selecciona contexto de ejecucion. A = 0 (sistema) o 1
; (usuario). Reprograma los bancos 0-6 (el 7, comun, no se toca).
; Llamado por BIOSKRNL.ASM via bnksel (salto de cola, no CALL) -- el
; "ret" de aqui es lo que devuelve el control al programa de usuario
; cuando A=1, ya con el banco 3 mostrando la pagina de usuario.
;
; Usa su PROPIA pila temporal (bank$stack, banco 7) mientras dura el
; bucle, en vez de la del llamante. Dos bugs reales encontrados en
; hardware con trazado paso a paso, relacionados pero distintos:
;
; 1) El propio "push bc" del bucle (guarda pagina y bloque mientras C
;    se reutiliza para el puerto) caia, la mayoria de las veces, en la
;    pila DEL LLAMANTE -- que puede estar en CUALQUIERA de los bloques
;    0-6 que este mismo bucle esta reprogramando (p.ej. la pila de la
;    propia CCP, en la TPA de usuario, bloque 0). Arreglado con
;    bank$stack (ver mas abajo).
;
; 2) MAS SUTIL, y el que quedaba: aunque ?bank ya no ESCRIBE en la pila
;    del llamante, la propia DIRECCION DE RETORNO que el llamante dejo
;    ahi (con su "call bnksel"/"call ?bank", ANTES de que este codigo
;    se ejecute) tambien vive en uno de esos bloques 0-6 -- y en cuanto
;    el bucle reprograma ESE bloque, esa direccion de retorno queda
;    "tapada" por lo que haya en la pagina nueva. Un "ret" normal al
;    final, por tanto, saca basura de ahi (confirmado en hardware:
;    volvia a una direccion de un "call" completamente distinto, de
;    mucho antes en la ejecucion). Solucion: leer esa direccion de
;    retorno ("pop hl") ANTES de tocar nada (con la pagina buena
;    todavia mapeada), guardarla en banco 7 (bank$retaddr), y saltar
;    ahi directamente al final con "jp (hl)" -- sin depender de una
;    pila que puede haber cambiado de pagina fisica bajo los pies.
; ---------------------------------------------------------------------
; CPM3_SD81: ?bank PRESERVA HL. Lo usa para su propio retorno (pop hl /
; jp (hl)), asi que lo destruia -- y como bnksel/selmemf se invocan con
; SALTO DE COLA desde sitios que devuelven valor en HL, el llamante
; recibia la direccion de retorno en vez del resultado.
;
; Caso confirmado en hardware: bank$bdos acaba en "mvi a,1 / jmp selmemf",
; y "parse:" (funcion 152) lee HL justo despues para saber por donde se
; quedo el analisis. Recibia $F2CD (su propia direccion de retorno), la
; traducia como si fuera un puntero al buffer comun y dejaba parsep
; apuntando a codigo de la CCP: NINGUNA orden se reconocia.
;
; Mismo bug que ya se arreglo en ?mov, pero alli se parcheo el sintoma en
; vez de la causa. Ahora se arregla aqui y vale para todos los llamantes.
?bank:      ld   (bank$savehl), hl
            pop  hl                  ; direccion de retorno real del
                                     ; llamante -- leida YA, antes de
                                     ; que el bucle reprograme el
                                     ; bloque donde vive (ver nota 2)
            ld   (bank$retaddr), hl
            ld   (bank$savesp), sp
            ld   sp, bank$stack
            push af
            push bc
            push de
            or   a
            jr   nz, bank_is1
            ld   d,BANK0_BASE
            jr   bank_go
bank_is1:   ld   d,BANK1_BASE
bank_go:    ld   e,7
            ld   c,0
bank_loop:  ld   a,d
            add  a,c
            ld   b,a
            push bc
            ld   a,c
            ld   c,0E7h
            out  (c),a
            pop  bc
            inc  c
            dec  e
            jr   nz, bank_loop
            pop  de
            pop  bc
            pop  af
            ld   sp, (bank$savesp)
            jp   bank$exit       ; banco 7: restaura HL y salta

; ---------------------------------------------------------------------
;  Tabla de saltos del BIOS (duplicada -- ver la nota mas arriba, junto
;  a los "extrn"). ?boot es la unica sin cambio de contexto.
; ---------------------------------------------------------------------
; =====================================================================
;  biosw - envoltorio de las entradas de E/S de caracter.
;
;  PROBLEMA QUE RESUELVE. El resto de la tabla hace "xor a / call bnksel
;  / jmp rutina": un SALTO de cola, asi que el "ret" de la rutina real
;  vuelve al llamante ORIGINAL con "sistema" ya seleccionado. Desde fuera,
;  pedir un caracter por consola te cambiaba el banco de forma permanente
;  y silenciosa.
;
;  En el CP/M+ de DRI eso no pasa porque toda la E/S de caracter es
;  residente (ver los cseg/dseg de BIOSKRNL.ASM) y no hay cambio de banco
;  ninguno. Aqui el driver real (?co/?ci, chario.z80) vive en memoria
;  bancada y no cabe en el banco 7, asi que reproducimos la GARANTIA en
;  vez de la estructura: una llamada al BIOS no altera el banco visible.
;
;  Sintoma que lo destapo: la BDOS sondea ?cist mientras espera una tecla,
;  asi que el sistema pasaba casi todo el tiempo en "sistema". La copia de
;  vuelta de la funcion 10 ("jmp movef" al final de rb$func10) escribia
;  entonces la linea leida en la pagina 0 en vez de en el buffer de la
;  CCP: se veia lo tecleado (el eco lo hace la BDOS al editar) pero la CCP
;  recibia un buffer sin actualizar, y toda orden daba "?".
;
;  DETALLE CRITICO: hay que cambiar a pila comun ANTES de tocar el
;  paginado. La pila del llamante esta en su banco, asi que un push antes
;  del cambio y su pop despues caerian en paginas fisicas distintas --
;  exactamente el error que ya nos mordio en ?bank.
;
;  Solo se envuelven las entradas de caracter: intercambian datos por
;  registros (caracter en C, resultado en A) y no usan HL, que es lo que
;  el envoltorio necesita para saber a donde saltar. Las de disco NO se
;  envuelven: las llama la BDOS bancada, que ya esta en "sistema", y
;  ademas ?sldsk/?sctrn DEVUELVEN valor en HL.
; =====================================================================
biosw:      ld   (bw$sp), sp     ; SP del llamante
            ld   sp, bw$stack    ; pila comun ANTES de tocar bancos
            ld   (bw$hl), hl     ; ?bank destruye HL
            ld   a, (@cbnk)
            ld   (bw$bnk), a     ; banco del llamante
            xor  a
            call bnksel          ; -> sistema (conserva AF/BC/DE)
            ld   hl, (bw$hl)
            ld   de, bw$back
            push de              ; direccion de vuelta, en la pila comun
            jp   (hl)            ; llamar a la rutina real
bw$back:    ld   (bw$a), a       ; valor devuelto
            ld   a, (bw$bnk)
            call bnksel          ; restaurar el banco del llamante
            ld   a, (bw$a)
            ld   sp, (bw$sp)     ; SP del llamante
            ret                  ; vuelve ya bajo el banco correcto

?boot:      jmp  boot            ; unica excepcion, ver nota arriba

?wboot:     xor  a
            call bnksel
            jmp  wboot
?const:     ld   hl, const
            jmp  biosw
?conin:     ld   hl, conin
            jmp  biosw
?cono:      ld   hl, conout
            jmp  biosw
?list:      ld   hl, list
            jmp  biosw
?auxo:      ld   hl, auxout
            jmp  biosw
?auxi:      ld   hl, auxin
            jmp  biosw

?home:      xor  a
            call bnksel
            jmp  home
?sldsk:     xor  a
            call bnksel
            jmp  seldsk
?sttrk:     xor  a
            call bnksel
            jmp  settrk
?stsec:     xor  a
            call bnksel
            jmp  setsec
?stdma:     xor  a
            call bnksel
            jmp  setdma
?read:      xor  a
            call bnksel
            jmp  read
?write:     xor  a
            call bnksel
            jmp  write

?lists:     ld   hl, listst
            jmp  biosw
?sctrn:     xor  a
            call bnksel
            jmp  sectrn

?conos:     ld   hl, conost
            jmp  biosw
?auxis:     ld   hl, auxist
            jmp  biosw
?auxos:     ld   hl, auxost
            jmp  biosw
?dvtbl:     xor  a
            call bnksel
            jmp  devtbl
?devin:     xor  a
            call bnksel
            jmp  ?cinit

?drtbl:     xor  a
            call bnksel
            jmp  getdrv
?mltio:     xor  a
            call bnksel
            jmp  multio
?flush:     xor  a
            call bnksel
            jmp  flush

; CPM3_SD81: ?mov/?xmov usan "call ?bank", NO "call bnksel" como el
; resto de la tabla -- es la excepcion deliberada (mismo tamaño, solo
; cambia el destino). ?bank reprograma el hardware SIN tocar @cbnk, asi
; que @cbnk sigue diciendo cual era el banco del llamante, que es
; justo lo que ?move necesita para restaurarlo al terminar ("mv$done:
; ld a,(@cbnk) / call ?bank", move.z80).
;
; Con "call bnksel" aqui, @cbnk quedaba a 0 antes de que ?move lo
; leyera y ?move restauraba "sistema" en vez del banco del llamante.
; Eso era correcto mientras la BDOS residente corria bajo sistema; con
; la BDOS entrando bajo USUARIO (ver call5_entry, init.z80) deja el
; contexto equivocado, y la cola de disk$function acaba en rb$goback
; leyendo la ROM en vez de la pila de la CCP.
;
; A estas dos entradas no las llaman programas de usuario (nadie llama
; a BIOS MOVE desde la TPA), solo la BDOS -- por eso pueden ser
; transparentes al banco sin romper el motivo por el que el resto de la
; tabla si actualiza @cbnk.
; BUG REAL, presente desde el principio. La convencion del BIOS de CP/M 3
; para MOVE es "HL = destino, DE = origen, BC = contador", pero ?bank
; termina con "ld hl,(bank$retaddr) / jp (hl)", o sea DESTRUYE HL. Asi
; que ?move recibia como destino la direccion del propio "jmp ?move"
; ($7EEC) en vez del destino real.
;
; Efecto: la primera copia de FCB de la BDOS (cpyfcbin: "lxi h,commonfcb
; / lxi b,36 / call movef") escribia 36 bytes JUSTO ENCIMA de la tabla de
; saltos -- ?tim, ?bnksl, ?stbnk, ?xmov, ?ldccp. Con ?bnksl machacada,
; todos los cambios de banco posteriores saltan a basura. De ahi las
; direcciones sin sentido que salian de bank$retaddr.
;
; HL se salva en banco 7 (comun) porque se escribe con el banco del
; llamante puesto y se lee ya bajo sistema.
; El caso normal (sin XMOVE pendiente) se resuelve AQUI MISMO, sin tocar
; el paginado. Es lo correcto y ademas lo unico que funciona: MOVE tiene
; que copiar dentro del banco del llamante, y este bloque esta duplicado
; en ambos contextos, asi que puede ejecutar el LDIR sin cambiar nada.
;
; Hacerlo dentro de ?move NO vale: ?move vive en memoria bancada, asi que
; para llegar a el hay que seleccionar sistema -- y entonces el LDIR
; copiaria del banco equivocado. Confirmado en hardware: la copia del FCB
; de la BDOS traia 36 bytes de $76 (el relleno de HALT de la pagina 0)
; porque se ejecutaba con sistema puesto.
?mov:       ld   a,b
            or   c
            ret  z               ; BC=0: nada que mover. Un LDIR con BC=0
                                  ; copiaria 65536 bytes.
            ld   a,(xmv$pend)    ; banco 7: legible bajo cualquier contexto
            or   a
            jr   nz, mov$bank

            ex   de,hl           ; HL=origen, DE=destino (orden de LDIR)
            ldir
            ex   de,hl           ; HL=destino+n, DE=origen+n (orden CP/M)
            ret

mov$bank:   xor  a
            call ?bank           ; ?bank ya preserva HL (ver su nota)
            jmp  ?move
?tim:       xor  a
            call bnksel
            jmp  ?time
?bnksl:     jmp  bnksel          ; el propio bnksel YA hace el cambio
?stbnk:     xor  a
            call bnksel
            jmp  setbnk
?xmov:      xor  a
            call ?bank           ; ver la nota en ?mov
            jmp  ?xmove

; ?ldccp/?rlccp: BIOSKRNL.ASM (boot$1/wboot) los llama DIRECTAMENTE, sin
; pasar por la tabla de arriba -- pero justo antes se ejecuta set$jumps,
; que YA selecciono "usuario" (correcto: la CCP se carga en su TPA). Nuestro
; stub (todavia sin CCP real) no necesita seguir en usuario, asi que
; vuelve a sistema antes de saltar al cuerpo real (init.z80, ldccp_real)
; -- igual patron que el resto de la tabla. Cuando haya CCP real, esto
; puede necesitar revisarse (el cuerpo real gestionara sus propios
; cambios de contexto segun haga falta).
?ldccp:     xor  a
            call bnksel
            jmp  ldccp_real
?rlccp:     xor  a
            call bnksel
            jmp  ldccp_real

; =====================================================================
;  FIN de la zona duplicada. A partir de aqui, memoria normal.
;
;  CPM3_SD81: este "org" FALTABA, y era un bug real y grave. El bloque
;  duplicado son los 512 bytes $7E00-$7FFF (SWITCHER_LEN), pero la tabla
;  de saltos termina sobre $7F1C, asi que todo lo que se incluye despues
;  (move.z80 el primero) empezaba AHI -- o sea, DENTRO de la zona que
;  dup_switcher copia a la pagina de usuario. Contradecia ademas lo que
;  dice la cabecera de este fichero ("?xmove/?move ... viven en zona
;  normal, no aqui").
;
;  Por que es grave: la zona duplicada vive en el bloque 3, que ?bank SI
;  repagina. Las variables de move.z80 (xmv$dbnk/xmv$sbnk/xmv$pend en
;  $7F1C-$7F1E, mv$de/mv$hl/mv$cnt detras) quedaban por tanto DUPLICADAS,
;  con una copia por contexto:
;
;    - ?move escribia mv$de/mv$hl/mv$cnt, hacia "call ?bank" para pasar al
;      otro contexto, y luego los leia de la OTRA copia -- la que
;      dup_switcher dejo congelada en el arranque.
;    - ?xmove ponia xmv$pend/xmv$sbnk en una copia y ?move los consultaba
;      en la otra.
;
;  Sintoma confirmado en hardware: la copia del FCB de la BDOS acababa
;  leyendo del banco 0 y trayendo 36 bytes de $76 (el relleno de HALT de
;  la pagina 0) en vez del FCB de la CCP.
;
;  $8000 es el primer byte fuera del bloque duplicado. Lo que viene
;  detras (move.z80, diskio.z80, drvtbl.z80, chario.z80, init.z80) se
;  desplaza ~228 bytes hacia arriba; sigue cabiendo de sobra antes del
;  "org 08900h" de BDOS.ASM.
; =====================================================================

            org  08000h
