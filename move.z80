; =====================================================================
;  move.z80 - ?xmove y ?time. Zona normal del banco 3 (sistema).
;
;  ?move ya NO esta aqui: su cuerpo y sus variables se mudaron a
;  bank.z80. El razonamiento que los mantenia aqui ("?move restaura el
;  contexto antes de su ret, asi que no hay problema") era falso: el
;  problema no es el "ret" final, sino que ?move cambia de banco EN
;  MEDIO, y mientras tanto sigue ejecutando -- y leyendo sus variables --
;  desde $8xxx, que en el banco de usuario es TPA vacia.
;
;  Contrato derivado de BDOS30.ASM (lineas 5551-5568, las dos llamadas
;  a deblock12->xmovef antes de una lectura/escritura de disco):
;    ?xmove: B = contexto destino, C = contexto origen. Solo memoriza.
;    ?move:  DE = direccion origen (contexto origen memorizado),
;            HL = direccion destino (contexto destino memorizado),
;            BC = numero de bytes. Copia en trozos de hasta 128 B via
;            @bnkbf (banco comun, siempre alcanzable pase lo que pase).
; =====================================================================

;            public ?move,?xmove,?time
;            extrn  @cbnk,?bank,@bnkbf   ; @bnkbf ahora lo define SCB.ASM

; ?time - pendiente: sin RTC real integrado todavia (el firmware del
; MCU tiene RTC.cpp, pero aun no esta conectado aqui). Por ahora no-op.
?time:      ret

; Las variables de ?xmove/?move (xmv$dbnk/xmv$sbnk/mv$de/mv$hl/mv$cnt/
; mv$len) y el cuerpo de ?move viven ahora en bank.z80 -- las primeras en
; banco 7 y el segundo en la zona duplicada. Ver la nota junto a ?move
; alli: este fichero se ensambla en memoria bancada y por tanto no puede
; sobrevivir a un cambio de banco. ?xmove si puede quedarse aqui: no
; conmuta nada, solo memoriza.

?xmove:     ld   a,b
            ld   (xmv$dbnk),a
            ld   a,c
            ld   (xmv$sbnk),a
            ld   a,0FFh
            ld   (xmv$pend),a    ; marca: el proximo ?move es entre bancos
            ret
