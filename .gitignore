# Windows
Thumbs.db
Desktop.ini

# salidas de ensamblado (zmac), regenerables con los build_*.bat
*.bin
*.cim
*.lst
*.rel
*.hex
*.sym

# trazas de depuracion, no son fuente
traza.txt

# FONT.BIN NO es una salida de ensamblado: es una FUENTE (el juego de
# caracteres ASCII de 7 px de ancho que genfont.py mezcla con el atlas
# CP437 para producir font_image.z80). Sin el no se puede regenerar.
!FONT.BIN
