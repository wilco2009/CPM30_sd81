; =====================================================================
;  chario.z80 - E/S de caracteres para BIOSKRNL.ASM: ?ci/?co/?cist/?cost
;  (dispositivo en B, contrato tabla 4-... del System Guide) + ?cinit +
;  @ctbl. Terminal (emulacion ADM-3A) + teclado ZX81 + cursor parpadeante
;  -- copiado del CP/M 2.2 (CPM_SD81/bios.z80, ya validado en hardware
;  real, incluidos los dos bugs de corrupcion de registros ya encontrados
;  y corregidos ahi: DE en char_addr, y BC/C en char_addr) SIN cambios de
;  logica, solo:
;    - _const/_conin/_conout -> ?cist/?ci/?co (mismo contrato: A=0FFh/0,
;      A=ASCII bloqueante, C=caracter -- BIOSKRNL solo anade B=dispositivo,
;      que ignoramos al haber un unico dispositivo fisico).
;    - anadidos ?cost (siempre listo, la escritura a pantalla nunca
;      bloquea) y ?cinit (sin nada que inicializar, sin baudios).
;    - variables sin atar a VARBASE+N (el 2.2 las fijaba a offsets
;      concretos del bloque 7; aqui son etiquetas sueltas, el ensamblado
;      final las coloca).
;    - trk/sec/dma/cur_disk/disk_handle/sd_off/vtdir/alv/csv del 2.2 NO
;      se traen -- ya son @trk/@sect/@dma de BIOSKRNL o viven en
;      diskio.z80/drvtbl.z80.
; =====================================================================

;            public ?ci,?co,?cist,?cost,?cinit,@ctbl

; CPM3_SD81: DFILE y ATTR salen de memmap.inc, que es donde viven
; DFILE_val/ATTR_val -- los mismos que programa start: en el override del
; FPGA. Antes esto era un 0E899h a pelo con un comentario que decia
; "TIENE QUE COINCIDIR"; ahora no puede dejar de coincidir.
DFILE       equ DFILE_val         ; buffer de pantalla
ATTR        equ ATTR_val          ; atributos, misma geometria que el DFILE
ATTR_OFF    equ ATTR_val-DFILE_val ; de un caracter a su color
                                ; con DFILE_val (init.z80), que es quien se
                                ; lo comunica al FPGA por POKE 2096/2097.
                                ; Movido desde $EA00 al empaquetar el banco 7
                                ; (ver la nota en init.z80).
SCRW        equ 80
SCRH        equ 24
ROWSTRIDE   equ 81              ; 80 caracteres + 1 byte de relleno
CURSOR_BLOCK equ 0DBh           ; bloque solido IBM/CP437 (cursor normal)
CURSOR_UNDER equ 05Fh           ; guion bajo de la ROM (cursor en modo CTRL)
BLINK_RATE  equ 25              ; pulsos de VSYNC por semiciclo de parpadeo
                                 ; (0.5 s a 50 Hz)

; ---------------------------------------------------------------------
;  @ctbl - un unico dispositivo fisico (la pantalla+teclado del ZX81).
;  Formato: nombre de 6 B + modo (1 B) + baudios (1 B), terminado en 0.
; ---------------------------------------------------------------------
            include "modebaud.lib"

; CPM3_SD81: @ctbl va en BANCO COMUN. BIOS DEVTBL devuelve su direccion
; al programa, que la lee desde el banco de usuario -- aqui, en el banco
; de sistema, DEVICE.COM leia TPA y sacaba "6$" donde debia poner "CON".
; Ver la nota en memmap.inc. Es de solo lectura y ocupa 9 bytes, asi que
; cabe en el hueco que quedaba detras de los DPB.

chario$save equ $            ; ver el "org" de cierre mas abajo

            org  CTBLORG

; Dispositivo 0: la pantalla + el teclado del ZX81.
@ctbl:      defb 'CON   '
            defb mb$in$out
            defb baud$none

; Dispositivo 1: el puente de red (net.z80). mb$serial porque por el
; canal viajan los comandos AT, como con un modem de verdad. Sin
; baudios: la velocidad la fija el otro extremo, no hay UART que
; programar, asi que DEVICE NET:[9600] no tiene nada que hacer.
            defb 'NET   '
            defb mb$in$out+mb$serial
            defb baud$none

            defb 0                  ; terminador de tabla

            ds   0F704h-$        ; guarda: detras, ldccp_real (init.z80)

; El estado comun de biosd (bank.z80), en el hueco que @ctbl dejo libre
; al mudarse. Ver la nota en memmap.inc.
            org  BD_RT
            defs 4
            ds   0F7A4h-$        ; guarda: detras, las variables de ?bank

            org  chario$save

; ---------------------------------------------------------------------
;  ?ci/?co/?cist/?cost - contrato de BIOSKRNL: B = numero de dispositivo
;  fisico, el indice dentro de @ctbl. 0 = CON, 1 = NET (net.z80).
;
;  Hasta ahora B se ignoraba porque solo habia un dispositivo. Ahora hay
;  dos, y este reparto es lo unico que hace falta para que funcionen las
;  rutinas auxin/auxout/auxist/auxost de BIOSKRNL.ASM: ellas recorren los
;  vectores @aivec/@aovec y llaman aqui con B puesto. O sea que un
;  "DEVICE AUX:=NET" ya deja el puente colgado del dispositivo logico AUX,
;  sin tocar una linea de la BDOS ni del BIOS.
;
;  Se reparte con "or a / jp nz", no con una tabla: son dos dispositivos,
;  y un B fuera de rango no puede llegar aqui (lo filtra @ctbl).
; ---------------------------------------------------------------------
?cist:      ld   a,b
            or   a
            jp   nz,net_cist
            ; cae a la consola
con_cist:                            ; A=0FFh si hay tecla, 0 si no
            ld   a,(ab_cnt)         ; respuesta a un DSR pendiente?
            or   a
            jr   nz,cst_yes         ; cuenta como tecla disponible
            call scan_keys          ; A=indice/0FFh, E: bit0=SHIFT bit1=ENTER
            cp   0FFh
            jr   nz,cst_yes         ; hay tecla normal
            bit  1,e                ; ENTER pulsado?
            jr   nz,cst_ent
            ; ENTER suelto: limpiar aqui el residual. Antes solo se
            ; limpiaba en ck_clr (dentro de kbget), y eso era un bloqueo
            ; mutuo: con enter_used=1 esta misma rutina responde "no hay
            ; tecla", la BDOS no llega a llamar a ?ci, y por tanto ck_clr
            ; no se ejecuta nunca -> el flag se quedaba a 1 para siempre.
            ; Sintoma: despues del primer ENTER+tecla (simbolo), ni ENTER
            ; ni SHIFT+ENTER volvian a responder.
            xor  a
            ld   (enter_used),a
            jr   cst_cur
cst_ent:    ld   a,(enter_used)     ; ENTER residual (ya dio simbolo)?
            or   a
            jr   z,cst_yes          ; no -> hay tecla (producira CR/CTRL)
cst_cur:    push de
            call cursor_blink_poll  ; sin tecla util: hacer avanzar el parpadeo
            pop  de
cst_no:     xor  a
            ret
cst_yes:    ld   a,0FFh
            ret

?ci:        ld   a,b                 ; A = ASCII (bloqueante)
            or   a
            jp   nz,net_ci
            jp   kbget

?co:        ld   a,b                 ; C = caracter
            or   a
            jp   nz,net_co
            ; cae a la consola (emulacion de terminal ANSI)
con_co:
            call cursor_clear       ; borrar el cursor antes de imprimir (coherencia)
            ld   a,(term_state)
            or   a
            jr   nz,co_seq          ; en medio de la secuencia ESC = fila col
            ld   a,c
            cp   01Bh               ; ESC -> inicio gotoxy
            jr   z,co_esc
            cp   01Ah               ; ^Z  -> borrar pantalla + home
            jp   z,cls
            cp   0Dh
            jr   z,co_cr
            cp   0Ah
            jr   z,co_lf
            cp   08h
            jr   z,co_bs
            cp   20h
            ret  c                  ; otros controles -> ignorar
; CPM3_SD81: aqui habia un "cp 080h / ret nc" que tiraba todo lo que no
; fuera ASCII imprimible. La fuente tiene los 256 glifos ($20-$FF), asi
; que no habia motivo: los codigos altos son los graficos y los acentos
; que necesita un terminal de verdad.
            jp   print_glyph
co_esc:     ld   a,1
            ld   (term_state),a     ; estado 1: recibido ESC
            ret
co_cr:      xor  a
            ld   (cur_col),a
            ret
co_lf:      jp   vtnl
co_bs:      ld   a,(cur_col)
            or   a
            ret  z
            dec  a
            ld   (cur_col),a
            ret
; --- secuencia ESC '=' fila col (gotoxy ADM-3A, offset $20) ---
co_seq:     cp   4
            jp   z,ansi_char        ; estado 4: dentro de ESC [
            dec  a
            jr   nz,co_seq23        ; estado != 1
            ld   a,c                ; estado 1: '=' (ADM-3A) o '[' (ANSI)
            cp   '='
            jr   z,co_adm3a
            cp   '['
            jr   z,co_ansi
            jr   co_abort           ; otra secuencia -> ignorar
co_adm3a:   ld   a,2
            ld   (term_state),a
            ret
co_ansi:    xor  a                  ; empieza ESC [ : parametros a cero
            ld   (ansi_n),a
            ld   (ansi_cnt),a
            ld   (ansi_priv),a
            ld   a,4
            ld   (term_state),a
            ret
co_seq23:   dec  a
            jr   nz,co_seqcol       ; estado 3 (columna)
            ld   a,c                ; estado 2: fila
            sub  020h
            cp   SCRH
            jr   c,co_rowok
            ld   a,SCRH-1
co_rowok:   ld   (cur_row),a
            ld   a,3
            ld   (term_state),a
            ret
co_seqcol:  ld   a,c                ; estado 3: columna
            sub  020h
            cp   SCRW
            jr   c,co_colok
            ld   a,SCRW-1
co_colok:   ld   (cur_col),a
co_abort:   xor  a
            ld   (term_state),a     ; fin de secuencia
            ret

; =====================================================================
;  ESC [ ... - secuencias ANSI (CSI).
;
;  De momento solo se interpreta la letra 'm' (SGR, el color); las demas
;  se consumen y se ignoran, que es lo correcto: un terminal que no
;  entiende una secuencia debe tragarsela entera, no escupirla por
;  pantalla. La fase siguiente sera anadir CUP/ED/EL y el movimiento del
;  cursor, para lo que ya esta montado el parser.
;
;  El byte de atributo es PPPP IIII: papel en los bits 7-4, tinta en los
;  3-0, y en cada nibble el bit alto es el brillo. Los colores del
;  hardware NO estan en el orden de ANSI, de ahi la tabla ansi_ctab.
; =====================================================================
; ---------------------------------------------------------------------
;  ansi_char - un byte dentro de una secuencia CSI (ESC [ ...).
;
;  Segun ECMA-48, detras de CSI vienen:
;      $20-$2F  bytes intermedios
;      $30-$3F  bytes de parametro (digitos, ';' y $3A-$3F privados)
;      $40-$7E  UN byte final, y ese es el unico que la termina.
;
;  Antes se terminaba con el primer byte que no fuera digito ni ';', y
;  eso parte por la mitad cualquier secuencia privada: con ESC[?1000l
;  (desactivar reporte de raton, lo que manda media BBS al despedirse)
;  el '?' se tomaba por la letra final y el "1000l" acababa impreso en
;  pantalla como texto. Visto contra una BBS de verdad.
;
;  Ahora los bytes privados e intermedios se absorben, y si la secuencia
;  llevaba alguno de $3A-$3F se ignora entera: son modos DEC que no
;  soportamos, y ejecutar la letra final sin entender el parametro seria
;  peor que no hacer nada.
; ---------------------------------------------------------------------
ansi_char:  ld   a,c
            cp   ';'
            jr   z,ansi_sep
            cp   '0'
            jr   c,ansi_int         ; $20-$2F: intermedio, absorber
            cp   '9'+1
            jr   nc,ansi_hi     ; $3A-$3F privado, o $40-$7E final
            sub  '0'                ; digito: n = n*10 + digito
            ld   e,a
            ld   a,(ansi_n)
            ld   d,a
            add  a,a
            add  a,a
            add  a,d
            add  a,a
            add  a,e
            ld   (ansi_n),a
            ret
ansi_sep:   jp   ansi_push          ; ';' cierra un parametro

ansi_hi:
            cp   040h
            jr   nc,ansi_end        ; $40-$7E: la letra final de verdad
            ld   (ansi_priv),a      ; $3A-$3F: marcar como privada
ansi_int:   ret                     ; absorber y seguir dentro de la secuencia

ansi_end:   ld   a,(ansi_priv)
            or   a
            jp   nz,ansi_done       ; secuencia privada: ignorarla entera
            call ansi_push          ; una letra cierra el ultimo y ejecuta
            ld   a,c
            cp   'm'
            jp   z,ansi_sgr
            cp   'H'
            jp   z,ansi_cup         ; CUP  ESC[fila;colH
            cp   'f'
            jp   z,ansi_cup         ; HVP, lo mismo
            cp   'A'
            jp   z,ansi_cuu         ; arriba
            cp   'B'
            jp   z,ansi_cud         ; abajo
            cp   'C'
            jp   z,ansi_cuf         ; derecha
            cp   'D'
            jp   z,ansi_cub         ; izquierda
            cp   'J'
            jp   z,ansi_ed          ; borrar pantalla
            cp   'K'
            jp   z,ansi_el          ; borrar linea
            cp   's'
            jp   z,ansi_scp         ; guardar posicion del cursor
            cp   'u'
            jp   z,ansi_rcp         ; restaurarla
            cp   'n'
            jp   z,ansi_dsr         ; "donde esta el cursor?"
ansi_done:  xor  a
            ld   (term_state),a
            ret

; --- helpers ---------------------------------------------------------
;  ansi_n1  - primer parametro, con 1 por defecto (los movimientos de
;             cursor son "n posiciones", y ESC[A vale por ESC[1A)
;  ansi_fill- rellena BC posiciones desde HL (direccion en el DFILE) con
;             espacios y cur_attr, caracter y color a la vez
ansi_n1:    ld   a,(ansi_par)
            or   a
            ret  nz
            inc  a
            ret

ansi_fill:  ld   a,b
            or   c
            ret  z
af_loop:    ld   (hl),' '
            push hl
            ld   de,ATTR_OFF
            add  hl,de
            ld   a,(cur_attr)
            ld   (hl),a
            pop  hl
            inc  hl
            dec  bc
            ld   a,b
            or   c
            jr   nz,af_loop
            ret

; --- CUP: ESC [ fila ; col H  (1-based; sin parametros, esquina) ------
ansi_cup:   ld   a,(ansi_par)
            or   a
            jr   nz,cup_r
            inc  a
cup_r:      dec  a
            cp   SCRH
            jr   c,cup_rok
            ld   a,SCRH-1
cup_rok:    ld   (cur_row),a
            ld   a,(ansi_cnt)
            cp   2
            jr   c,cup_c0           ; sin columna: la 1
            ld   a,(ansi_par+1)
            or   a
            jr   nz,cup_c
            inc  a
cup_c:      dec  a
            jr   cup_cc
cup_c0:     xor  a
cup_cc:     cp   SCRW
            jr   c,cup_cok
            ld   a,SCRW-1
cup_cok:    ld   (cur_col),a
            jp   ansi_done

; --- movimiento del cursor -------------------------------------------
ansi_cuu:   call ansi_n1
            ld   b,a
            ld   a,(cur_row)
            sub  b
            jr   nc,cuu_ok
            xor  a                  ; tope arriba
cuu_ok:     ld   (cur_row),a
            jp   ansi_done

; El "jr c" de la suma NO es opcional: con ESC[255B desde la fila 23,
; 23+255 = 278, que en 8 bits es 22. El "cp SCRH" veria un 22, lo daria
; por bueno y el cursor acabaria en la fila 22 en vez de en la 23.
; Justo el caso que usan las BBS para medir la pantalla (ver ansi_dsr),
; asi que les estabamos diciendo que el terminal es de 23x79.
ansi_cud:   call ansi_n1
            ld   b,a
            ld   a,(cur_row)
            add  a,b
            jr   c,cud_max          ; se salio de los 8 bits: al tope
            cp   SCRH
            jr   c,cud_ok
cud_max:    ld   a,SCRH-1           ; tope abajo
cud_ok:     ld   (cur_row),a
            jp   ansi_done

ansi_cuf:   call ansi_n1
            ld   b,a
            ld   a,(cur_col)
            add  a,b
            jr   c,cuf_max
            cp   SCRW
            jr   c,cuf_ok
cuf_max:    ld   a,SCRW-1           ; tope derecha
cuf_ok:     ld   (cur_col),a
            jp   ansi_done

ansi_cub:   call ansi_n1
            ld   b,a
            ld   a,(cur_col)
            sub  b
            jr   nc,cub_ok
            xor  a                  ; tope izquierda
cub_ok:     ld   (cur_col),a
            jp   ansi_done

; --- ED: ESC[J del cursor al final, ESC[2J toda la pantalla ----------
;  El cursor NO se mueve con ESC[J (lo dice el estandar). Con ESC[2J
;  muchos programas cuentan con que ademas va a la esquina, asi que se
;  reutiliza cls, que ya borra caracteres y atributos y hace home.
ansi_ed:    ld   a,(ansi_par)
            cp   2
            jr   nz,ed_0
            call cls                ; CALL, no JP: hay que volver para
            jp   ansi_done          ; dejar term_state en 0. Con "jp z,cls"
                                     ; el parser se quedaba en el estado 4 y
                                     ; se comia el ESC de la secuencia
                                     ; siguiente.
ed_0:       ld   a,(ansi_par)
            or   a
            jp   nz,ansi_done       ; ESC[1J no implementado
            call char_addr          ; del cursor al final de la pantalla
            push hl
            ex   de,hl
            ld   hl,DFILE+1+ROWSTRIDE*SCRH
            or   a
            sbc  hl,de
            ld   b,h
            ld   c,l
            pop  hl
            call ansi_fill
            jp   ansi_done

; --- EL: ESC[K del cursor al fin de linea, ESC[2K la linea entera -----
ansi_el:    ld   a,(ansi_par)
            cp   2
            jr   z,el_all
            or   a
            jp   nz,ansi_done       ; ESC[1K no implementado
            call char_addr          ; del cursor al fin de linea
            ld   a,(cur_col)
            ld   b,a
            ld   a,SCRW
            sub  b
            jr   el_fill
el_all:     ld   a,(cur_col)        ; la linea entera: retroceder al margen
            push af
            xor  a
            ld   (cur_col),a
            call char_addr
            pop  af
            ld   (cur_col),a
            ld   a,SCRW
el_fill:    ld   c,a
            ld   b,0
            call ansi_fill
            jp   ansi_done

ansi_push:  ld   a,(ansi_cnt)
            cp   4
            jr   nc,ap_full         ; mas de 4 parametros: se descartan
            ld   hl,ansi_par
            ld   e,a
            ld   d,0
            add  hl,de
            ld   a,(ansi_n)
            ld   (hl),a
            ld   a,(ansi_cnt)
            inc  a
            ld   (ansi_cnt),a
ap_full:    xor  a
            ld   (ansi_n),a
            ret

ansi_sgr:   ld   a,(ansi_cnt)
            or   a
            jr   nz,sgr_loop0
            ld   a,ATTR_SCREEN      ; "ESC [ m" a secas = reset
            ld   (cur_attr),a
            jp   ansi_done
sgr_loop0:  ld   b,a
            ld   hl,ansi_par
sgr_loop:   ld   a,(hl)
            push hl
            push bc
            call sgr_apply
            pop  bc
            pop  hl
            inc  hl
            djnz sgr_loop
            jp   ansi_done

sgr_apply:  or   a                  ; 0 = todo a los valores por defecto
            jr   nz,sgr_n1
            ld   a,ATTR_SCREEN
            ld   (cur_attr),a
            ret
sgr_n1:     cp   1                  ; 1 = brillo en la tinta
            jr   nz,sgr_fg
            ld   a,(cur_attr)
            or   008h
            ld   (cur_attr),a
            ret
sgr_fg:     cp   30                 ; 30-37 = color de tinta
            ret  c
            cp   38
            jr   nc,sgr_bg
            sub  30
            call ansi2chroma
            ld   b,a
            ld   a,(cur_attr)
            and  0F8h               ; conserva papel y el brillo de tinta
            or   b
            ld   (cur_attr),a
            ret
sgr_bg:     cp   40                 ; 40-47 = color de papel
            ret  c
            cp   48
            ret  nc
            sub  40
            call ansi2chroma
            add  a,a
            add  a,a
            add  a,a
            add  a,a                ; el papel va en los bits 7-4
            ld   b,a
            ld   a,(cur_attr)
            and  08Fh               ; conserva tinta y el brillo del papel
            or   b
            ld   (cur_attr),a
            ret

ansi2chroma:                        ; A = color ANSI (0-7) -> color del hardware
            ld   hl,ansi_ctab
            ld   e,a
            ld   d,0
            add  hl,de
            ld   a,(hl)
            ret
ansi_ctab:  defb 0,2,4,6,1,3,5,7    ; negro rojo verde amarillo azul magenta cian blanco

; =====================================================================
;  Lo que sigue NO cabe en el tramo apretado $8000-$89FF del XIOS: al
;  anadirlo se paso por 102 bytes. Se muda igual que hicieron rtc.z80 y
;  net.z80. Ver la nota en memmap.inc.
; =====================================================================
chario$ansi$save equ $

            org  ANSIORG

; --- SCP/RCP: ESC[s guarda la posicion, ESC[u la restaura ------------
ansi_scp:   ld   a,(cur_row)
            ld   (sav_row),a
            ld   a,(cur_col)
            ld   (sav_col),a
            jp   ansi_done

ansi_rcp:   ld   a,(sav_row)
            ld   (cur_row),a
            ld   a,(sav_col)
            ld   (cur_col),a
            jp   ansi_done

; ---------------------------------------------------------------------
;  DSR: ESC[6n - "¿donde esta el cursor?". Se contesta ESC[fila;colR.
;
;  No es un adorno: las BBS lo usan para medir la pantalla. Mandan
;  ESC[s, ESC[255B, ESC[255C, ESC[6n, ESC[u -- o sea, el cursor a la
;  esquina de abajo a la derecha, preguntan donde acabo, y eso les dice
;  cuantas filas y columnas hay. Si no se contesta, el programa se queda
;  esperando la respuesta y acaba colgando por timeout. Visto con Mystic.
;
;  La respuesta sale por el CANAL DE ENTRADA, no por el de salida: se
;  mete en un bufer que ?cist y kbget sirven antes que el teclado, como
;  si la hubieras tecleado tu. Es exactamente lo que hace un terminal de
;  verdad -- un VT100 contesta al DSR por la misma linea serie por la
;  que viajan las pulsaciones -- y tiene la ventaja de que el programa
;  de comunicaciones no necesita enterarse de nada: lee "teclas" y las
;  manda, sin saber que se las ha inventado el terminal.
;
;  Las coordenadas de ANSI empiezan en 1 y las nuestras en 0, de ahi los
;  "inc a".
; ---------------------------------------------------------------------
ansi_dsr:   ld   a,(ansi_par)
            cp   6
            jp   nz,ansi_done       ; solo se entiende el DSR 6
            ld   hl,ab_buf
            ld   (hl),01Bh
            inc  hl
            ld   (hl),'['
            inc  hl
            ld   a,(cur_row)
            cp   SCRH
            jr   c,dsr_r
            ld   a,SCRH-1
dsr_r:      inc  a
            call ab_num
            ld   (hl),';'
            inc  hl
            ld   a,(cur_col)
            cp   SCRW               ; tras imprimir en la ultima columna
            jr   c,dsr_c            ; cur_col puede valer SCRW: no se
            ld   a,SCRW-1           ; puede contestar una columna 81
dsr_c:      inc  a
            call ab_num
            ld   (hl),'R'
            inc  hl
            ld   de,ab_buf
            or   a                  ; limpiar acarreo para el sbc
            sbc  hl,de
            ld   a,l                ; A = cuantos bytes se han montado
            ld   (ab_cnt),a
            ld   hl,ab_buf
            ld   (ab_ptr),hl
            jp   ansi_done

;  ab_num - A (1..99) en decimal a (HL), avanzando HL. Sin cero a la
;  izquierda: ESC[7;3R, no ESC[07;03R.
ab_num:     ld   b,'0'-1
ab_d10:     inc  b
            sub  10
            jr   nc,ab_d10
            add  a,10
            ld   c,a                ; C = unidades
            ld   a,b
            cp   '0'
            jr   z,ab_uni           ; no hay decenas que sacar
            ld   (hl),a
            inc  hl
ab_uni:     ld   a,c
            add  a,'0'
            ld   (hl),a
            inc  hl
            ret

; --- tabla de filas para char_addr (ver la nota alli) ----------------
;  row_tab[fila] = direccion del primer caracter de esa fila. La calcula
;  el ensamblador, asi que en ejecucion es una lectura y ya.
row_tab:    defw DFILE+1+ROWSTRIDE*0,  DFILE+1+ROWSTRIDE*1
            defw DFILE+1+ROWSTRIDE*2,  DFILE+1+ROWSTRIDE*3
            defw DFILE+1+ROWSTRIDE*4,  DFILE+1+ROWSTRIDE*5
            defw DFILE+1+ROWSTRIDE*6,  DFILE+1+ROWSTRIDE*7
            defw DFILE+1+ROWSTRIDE*8,  DFILE+1+ROWSTRIDE*9
            defw DFILE+1+ROWSTRIDE*10, DFILE+1+ROWSTRIDE*11
            defw DFILE+1+ROWSTRIDE*12, DFILE+1+ROWSTRIDE*13
            defw DFILE+1+ROWSTRIDE*14, DFILE+1+ROWSTRIDE*15
            defw DFILE+1+ROWSTRIDE*16, DFILE+1+ROWSTRIDE*17
            defw DFILE+1+ROWSTRIDE*18, DFILE+1+ROWSTRIDE*19
            defw DFILE+1+ROWSTRIDE*20, DFILE+1+ROWSTRIDE*21
            defw DFILE+1+ROWSTRIDE*22, DFILE+1+ROWSTRIDE*23

; Las variables del bloque viven aqui tambien: cada byte que se queda en
; el XIOS es un byte que le falta para caber.
sav_row:    defs 1               ; ESC[s / ESC[u
sav_col:    defs 1
ab_buf:     defs 10              ; respuesta al DSR: ESC[nn;nnR = 8 bytes
ab_cnt:     defs 1               ; cuantos quedan por servir
ab_ptr:     defs 2               ; el siguiente

            ds   LDR_BASE-$      ; guarda: detras, el cargador

            org  chario$ansi$save

?cost:      ld   a,b
            or   a
            jp   nz,net_cost
            ld   a,0FFh              ; la escritura a pantalla nunca bloquea
            ret

; ?cinit recibe el dispositivo en C, no en B (BIOSKRNL.ASM:110). Da igual:
; ninguno de los dos tiene nada que inicializar -- la consola porque la
; configuro "start" antes de arrancar, y NET porque la velocidad la fija
; el otro extremo.
?cinit:     ret

print_glyph:                        ; A = carácter (20h..7Fh) en el cursor
            push af
            call char_addr          ; HL = direccion en pantalla de (cur_row,cur_col)
            pop  af
            ld   (hl),a
; CPM3_SD81 (color): y el atributo, en la posicion equivalente. ATTR y el
; DFILE tienen la MISMA geometria (1+24*81), asi que basta con sumarle
; una constante a la direccion del caracter.
            push af
            push hl
            ld   de,ATTR_OFF
            add  hl,de
            ld   a,(cur_attr)
            ld   (hl),a
            pop  hl
            pop  af
            ld   a,(cur_col)
            inc  a
            cp   SCRW
            jr   c,pg_set
            xor  a
            ld   (cur_col),a
            jp   vtnl
pg_set:     ld   (cur_col),a
            ret

; ---------------------------------------------------------------------
;  char_addr - HL = DFILE+1+cur_row*ROWSTRIDE+cur_col (posicion en pantalla)
; ---------------------------------------------------------------------
;  OJO: no debe tocar DE ni BC vistos desde fuera -- se llama (via
;  cursor_clear/cursor_toggle) desde dentro de ck_key/?co, ENTRE que el
;  llamador guarda algo en E o C y lo usa despues (SHIFT/ENTER en ck_key;
;  el caracter a imprimir en C, en ?co). Dos bugs reales de esto, ya
;  encontrados y corregidos en el 2.2 con el depurador: E corrompida por
;  el DE que usaba antes esta rutina; C corrompida por un "ld bc,DFILE+1"
;  sin restaurar -- explicaba caracteres que "se memorizaban" en CP/M
;  (CONIN los captura bien) pero no se pintaban (CONOUT lee C DESPUES de
;  cursor_clear).
;  La fila NO se multiplica sumando en un bucle, que es como estaba: eran
;  hasta 23 vueltas de unos 55 ciclos, y esta rutina se llama DOS veces
;  por caracter impreso (una desde cursor_clear al entrar en ?co y otra
;  desde print_glyph). En la mitad baja de la pantalla se iban ~2500
;  ciclos por caracter, que con una BBS mandando arte ANSI a pantalla
;  completa es la diferencia entre seguirle el ritmo y no seguirlo. La
;  tabla cuesta 48 bytes y deja la cuenta en unos 40 ciclos.
char_addr:  push bc
            ld   a,(cur_row)
            add  a,a                ; fila*2 = indice en la tabla
            ld   c,a
            ld   b,0
            ld   hl,row_tab
            add  hl,bc
            ld   a,(hl)
            inc  hl
            ld   h,(hl)
            ld   l,a                ; HL = principio de la fila
            ld   a,(cur_col)
            add  a,l
            ld   l,a
            jr   nc,ca_ret
            inc  h
ca_ret:     pop  bc
            ret

vtnl:       ld   a,(cur_row)
            inc  a
            cp   SCRH
            jr   c,nl_st
            call scroll
            ld   a,SCRH-1
nl_st:      ld   (cur_row),a
            ret

scroll:     ld   hl,DFILE+1+ROWSTRIDE
            ld   de,DFILE+1
            ld   bc,ROWSTRIDE*(SCRH-1)
            ldir
            ld   hl,DFILE+1+ROWSTRIDE*(SCRH-1)
            ld   (hl),' '
            ld   de,DFILE+1+ROWSTRIDE*(SCRH-1)+1
            ld   bc,ROWSTRIDE-1
            ldir

; CPM3_SD81 (color): y lo mismo con los atributos. Sin esto, el texto
; sube pero los colores se quedan quietos, asi que cada linea cambia de
; color al desplazarse -- la pantalla se "estropea" en cuanto hay
; scroll.
;
; La linea nueva se rellena con cur_attr, no con ATTR_SCREEN: es lo que
; hace un terminal de verdad, el hueco que aparece al desplazar toma el
; color con el que se esta escribiendo.
            ld   hl,ATTR+1+ROWSTRIDE
            ld   de,ATTR+1
            ld   bc,ROWSTRIDE*(SCRH-1)
            ldir
            ld   a,(cur_attr)
            ld   hl,ATTR+1+ROWSTRIDE*(SCRH-1)
            ld   (hl),a
            ld   de,ATTR+1+ROWSTRIDE*(SCRH-1)+1
            ld   bc,ROWSTRIDE-1
            ldir
            ret

cls:        ld   hl,DFILE
            ld   (hl),' '
            ld   de,DFILE+1
            ld   bc,1+ROWSTRIDE*SCRH-1
            ldir
; CPM3_SD81 (color): los atributos, igual. Si no, al borrar la pantalla
; los colores viejos se quedan puestos y el texto nuevo sale sobre ellos.
            ld   a,(cur_attr)
            ld   hl,ATTR
            ld   (hl),a
            ld   de,ATTR+1
            ld   bc,1+ROWSTRIDE*SCRH-1
            ldir
            xor  a
            ld   (cur_col),a
            ld   (cur_row),a
            ret

; ---------------------------------------------------------------------
;  kbget — teclado ZX81 (copia de bios.z80/conin.asm)
; ---------------------------------------------------------------------
kbget:                              ; devuelve ASCII en A
            ld   a,(ab_cnt)         ; la respuesta al DSR va primero: el
            or   a                  ; programa la lee como si fuera algo
            jr   nz,kb_ans          ; que has tecleado tu. Ver ansi_dsr.
ck_top:     ld   a,(ctrl_prefix)
            or   a
            jr   nz,ck_pwait        ; modo CTRL armado -> esperar la tecla
            xor  a
            ld   (mods_seen),a      ; modo normal: reiniciar mods vistos
ck_nwait:   call wait_scan          ; A=idx/FF ; E: bit0=SHIFT bit1=ENTER
            cp   0FFh
            jr   nz,ck_key          ; hay tecla -> procesar (normal/shift/enter)
            ld   a,(mods_seen)      ; sin tecla: acumular modificadores vistos
            or   e
            ld   (mods_seen),a
            ld   a,e
            and  3
            jr   nz,ck_nwait        ; algun modificador aun pulsado -> seguir
            ld   a,(mods_seen)      ; todo suelto: decidir segun lo visto
            and  3
            jr   z,ck_clr           ; sin modificadores
            cp   3
            jr   z,ck_arm           ; SHIFT+ENTER -> armar modo CTRL
            bit  1,a
            jr   z,ck_clr           ; solo SHIFT -> nada
            ld   a,(enter_used)     ; solo ENTER
            or   a
            jr   nz,ck_clr          ; ENTER ya genero simbolo -> no CR
            call cursor_clear
            ld   a,0Dh              ; ENTER solo -> CR
            ret
; --- servir un byte de la respuesta al DSR (ver ansi_dsr) ------------
kb_ans:     dec  a
            ld   (ab_cnt),a
            ld   hl,(ab_ptr)
            ld   a,(hl)
            inc  hl
            ld   (ab_ptr),hl
            ret

ck_clr:     xor  a
            ld   (enter_used),a
            jr   ck_top
ck_arm:     call cursor_clear       ; borrar cursor (bloque) antes de cambiar forma
            ld   a,1
            ld   (ctrl_prefix),a    ; modo CTRL (cursor pasara a subrayado)
            jr   ck_top
; --- modo CTRL armado: la siguiente tecla -> CTRL+letra ---
ck_pwait:   call wait_scan
            cp   0FFh
            jr   z,ck_pwait
            push af
            call cursor_clear
            pop  af
            ld   (km_idx),a         ; guardar indice (scan_keys machaca C)
ck_prel:    call scan_keys          ; esperar a soltar la tecla
            cp   0FFh
            jr   nz,ck_prel
            xor  a
            ld   (ctrl_prefix),a    ; desarmar modo CTRL
            ld   hl,keymap
            ld   a,(km_idx)
            ld   c,a
            ld   b,0
            add  hl,bc
            ld   a,(hl)
            and  01Fh               ; CTRL = letra AND $1F
            ret
; --- tecla con modificadores (SHIFT / ENTER / ambos) ---
ck_key:     push af                 ; borrar cursor antes de procesar (preserva indice)
            call cursor_clear
            pop  af
            ld   (km_idx),a
            ld   a,e
            ld   (km_mods),a
ck_rel:     call scan_keys          ; esperar a soltar la tecla; ACUMULAR mods
            push af
            ld   a,(km_mods)
            or   e
            ld   (km_mods),a
            pop  af
            cp   0FFh
            jr   nz,ck_rel
            ld   a,(km_mods)
            cp   3                  ; SHIFT+ENTER+tecla directo -> CTRL (tambien)
            jr   z,ck_ctrl
            ld   hl,keymap
            bit  1,a                ; ENTER -> simbolos
            jr   z,ck_nse
            ld   hl,keymap_sym
            jr   ck_tbl
ck_nse:     bit  0,a                ; SHIFT -> mayusculas/funciones
            jr   z,ck_tbl
            ld   hl,keymap_shift
ck_tbl:     ld   a,(km_idx)
            ld   c,a
            ld   b,0
            add  hl,bc
            ld   a,(hl)
            or   a
            jp   z,ck_top           ; sin ASCII -> reesperar
            jr   ck_mods
ck_ctrl:    ld   hl,keymap          ; letra base -> CTRL = letra AND $1F
            ld   a,(km_idx)
            ld   c,a
            ld   b,0
            add  hl,bc
            ld   a,(hl)
            and  01Fh
ck_mods:    ld   c,a                ; codigo a devolver
            ld   a,(km_mods)        ; si ENTER fue modificador, marcar consumido
            bit  1,a
            jr   z,ck_ret
            ld   a,1
            ld   (enter_used),a
ck_ret:     ld   a,c
            ret

scan_keys:  ; A=indice (1..39) o 0FFh ; E: bit0=SHIFT, bit1=ENTER
            ld   bc,0FEFEh          ; SHIFT (A8 D0)
            in   a,(c)
            ld   e,0
            rra
            jr   c,sk_r0
            inc  e                  ; E bit0 = SHIFT
sk_r0:      or   0F0h               ; A8: D0=Z D1=X D2=C D3=V
            ld   d,1
            ld   c,4
sk_r0b:     rra
            jr   nc,sk_done
            inc  d
            dec  c
            jr   nz,sk_r0b
            ld   b,0BFh             ; ENTER (A14 D0)
            ld   c,0FEh
            in   a,(c)
            bit  0,a
            jr   nz,sk_e0
            set  1,e                ; E bit1 = ENTER
sk_e0:      ld   hl,row_lines+1     ; filas A9..A15
            ld   d,5
sk_row:     ld   a,(hl)
            or   a
            jr   z,sk_no
            ld   b,a
            ld   c,0FEh
            in   a,(c)
            or   0E0h
            bit  6,b                ; A14 (0BFh): bit6=0 -> ignorar D0 (ENTER)
            jr   nz,sk_nm
            or   1
sk_nm:      ld   c,5
sk_rb:      rra
            jr   nc,sk_done
            inc  d
            dec  c
            jr   nz,sk_rb
            inc  hl
            jr   sk_row
sk_no:      ld   a,0FFh
            ret
sk_done:    ld   a,d
            ret

; ---------------------------------------------------------------------
;  Cursor parpadeante en (cur_col,cur_row): bloque solido / subrayado segun
;  ctrl_prefix, sincronizado con VSYNC real (ver cursor_blink_poll).
; ---------------------------------------------------------------------
wait_scan:  call scan_keys          ; como scan_keys, pero hace avanzar el parpadeo si no hay tecla
            cp   0FFh
            ret  nz                 ; hay tecla -> A=indice/E validos
            push de
            call cursor_blink_poll
            pop  de
            ld   a,0FFh             ; SIEMPRE "sin tecla"
            ret

cursor_clear:                       ; si el cursor esta dibujado (fase visible), borrarlo
            ld   a,(cursor_on)
            or   a
            ret  z
            jp   cursor_toggle

cursor_toggle:                      ; alterna entre el caracter real y el glifo de
                                    ; cursor en (cur_col,cur_row), y lleva cursor_on
                                    ; con el estado.
            call char_addr
            ld   a,(cursor_on)
            or   a
            jr   nz,curt_hide
curt_show:  ld   a,(hl)
            ld   (cursor_save),a    ; guardar el caracter real antes de taparlo
            ld   a,(ctrl_prefix)
            or   a
            ld   a,CURSOR_BLOCK
            jr   z,curt_put
            ld   a,CURSOR_UNDER     ; modo CTRL: cursor de subrayado
curt_put:   ld   (hl),a
            ld   a,1
            ld   (cursor_on),a
            ret
curt_hide:  ld   a,(cursor_save)
            ld   (hl),a
            xor  a
            ld   (cursor_on),a
            ret

; ---------------------------------------------------------------------
;  cursor_blink_poll - ver bios.z80 (2.2): suma directamente los pulsos
;  VSYNC (bits 6..1 del puerto $AF, contador desde la ultima lectura) a
;  (blink) en vez de detectar flancos a mano; aritmetica de 8 bits a
;  proposito (una version de 16 bits perdia pulsaciones de teclado, ver
;  CPM_SD81/memory_map.md).
; ---------------------------------------------------------------------
cursor_blink_poll:
            in   a,(0AFh)
            and  07Eh               ; bits 6..1 = pulsos VSYNC desde la ultima lectura
            rrca                    ; -> valor 0-63 en A
            or   a
            ret  z                  ; nada que contar esta vez
            ld   c,a
            ld   hl,blink
            ld   a,(hl)
            add  a,c
            cp   BLINK_RATE
            jr   c,cbp_store
            sub  BLINK_RATE          ; (blink) >= BLINK_RATE: conservar remanente
            ld   (hl),a
            jp   cursor_toggle       ; cambia de fase (muestra/oculta)
cbp_store:  ld   (hl),a
            ret

row_lines:  defb 0FEh,0FDh,0FBh,0F7h,0EFh,0DFh,0BFh,07Fh,000h
keymap:     defb 000h,'z','x','c','v'      ; A8 : SHIFT Z X C V (base)
            defb 'a','s','d','f','g'       ; A9
            defb 'q','w','e','r','t'       ; A10
            defb '1','2','3','4','5'       ; A11
            defb '0','9','8','7','6'       ; A12
            defb 'p','o','i','u','y'       ; A13
            defb 00Dh,'l','k','j','h'      ; A14
            defb ' ','.','m','n','b'       ; A15

keymap_shift: ; SHIFT: mayusculas A-Z + funciones (0=borrar, 5/6/7/8=flechas WordStar)
            defb 000h,'Z','X','C','V'      ; A8 : SHIFT Z X C V
            defb 'A','S','D','F','G'       ; A9
            defb 'Q','W','E','R','T'       ; A10
            defb 01Bh,000h,000h,000h,013h  ; A11: 1=ESC, 2-4 nada, 5=izq(^S)
            defb 07Fh,008h,004h,005h,018h  ; A12: 0=DEL,9=BS,8=der(^D),7=arr(^E),6=abj(^X)
            defb 'P','O','I','U','Y'       ; A13
            defb 00Dh,'L','K','J','H'      ; A14
            defb ' ',009h,'M','N','B'      ; A15: .=TAB
             ; SHIFT+9 = BS ($08), pegado al SHIFT+0 = DEL ($7F): las dos
             ; teclas de borrar, juntas.
             ;
             ; No son dos funciones distintas. En ASCII no existe "borrar
             ; a la derecha": BS retrocede el cursor y DEL es el "rubout"
             ; de la cinta perforada (los 7 bits a uno = todos los
             ; agujeros hechos = ignorame). En terminales los dos
             ; acabaron significando lo mismo, borrar a la izquierda, y
             ; que tecla manda cual depende del terminal -- de ahi el
             ; "stty erase" de Unix. Por eso hacen falta los dos: es la
             ; misma funcion que cada software remoto espera en un byte
             ; distinto.
             ;
             ; SHIFT+. = TAB ($09). El punto esta al lado del espacio, y
             ; un tabulador es un espacio grande; ademas SHIFT+. daba un
             ; punto igual que sin SHIFT, o sea que no se pierde nada.
             ;
             ; Las dos se podian teclear ya con SHIFT+ENTER y luego H o I,
             ; pero son dos pulsaciones y en un formulario de BBS se usan
             ; constantemente.

keymap_sym:  ; ENTER+tecla: los simbolos serigrafiados del ZX81, mas los
             ; que hay que inventarse. La serigrafia no llega a todo el
             ; ASCII, y en una BBS se echa de menos: @ para el correo,
             ; \ | ~ ` para cualquier cosa de Unix, y _ # % & ! para los
             ; menus. Los que faltaban van en A9 (A S D F G), que estaba
             ; entera sin usar, y en los huecos de A10-A12.
            defb 000h,':',';','?','/'      ; A8 : SHIFT Z X C V
            defb 000h,05Ch,000h,07Eh,060h  ; A9 : S=\ F=~ G=`
            defb 027h,07Bh,07Dh,05Bh,05Fh  ; A10: Q=' W={ E=} R=[ T=_
            defb '!',040h,'#',07Ch,'%'     ; A11: 1=! 2=@ 3=# 4=| 5=%
            defb 01Dh,01Ch,01Eh,000h,'&'   ; A12: 0=^] 9=^\ 8=^^ 6=&
             ; ENTER+0 = $1D (^]), ENTER+9 = $1C (^\) y ENTER+8 = $1E
             ; (^^). El modo CTRL
             ; (SHIFT+ENTER) saca la letra AND $1F, asi que llega de ^A a
             ; ^Z y a NUL con el espacio, pero para $1B-$1F harian falta
             ; [ \ ] ^ _ en el mapa base, donde solo hay letras y digitos.
             ; ESC se salva porque esta aparte en SHIFT+1.
             ;
             ; Estos tres son justo los que usa TERM.COM para lo suyo
             ; (salir, conmutar el eco local y arrancar/parar el volcado).
             ; Van ahi precisamente porque ninguna BBS los usa: si fueran
             ; CTRL+letra, un dia te comerian una tecla que hace falta
             ; mandar.
            defb 022h,')','(','$',05Dh     ; A13: P=" O=) I=( U=$ Y=]
            defb 00Dh,'=','+','-',05Eh     ; A14: L== K=+ J=- H=^
            defb ' ',',','>','<','*'       ; A15: .=, M=> N=< B=*

; ---------------------------------------------------------------------
;  Variables (zona comun -- datos, no codigo)
; ---------------------------------------------------------------------
cur_col:    defs 1
cur_row:    defs 1
km_idx:     defs 1
km_mods:    defs 1
enter_used: defs 1
blink:      defs 1
cursor_on:  defs 1
term_state: defs 1
cur_attr:   defb ATTR_SCREEN     ; color con el que se imprime ahora
ansi_n:     defs 1               ; parametro ANSI que se acumula
ansi_par:   defs 4               ; parametros ya cerrados
ansi_cnt:   defs 1               ; cuantos hay
ansi_priv:  defs 1               ; !=0 si la secuencia lleva un byte privado
                                 ; (sav_row, ab_buf y companeras estan en
                                 ;  el bloque de ANSIORG, mas arriba)
mods_seen:  defs 1
ctrl_prefix: defs 1
cursor_save: defs 1
