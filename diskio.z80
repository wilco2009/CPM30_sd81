; =====================================================================
;  diskio.z80 - Rutinas READ/WRITE/LOGIN/INIT para las 5 unidades del
;  XDPH (A-D = SD via protocolo MCU, E = disco RAM), contrato de la
;  tabla 4-11 del CP/M 3 System Guide:
;    Entrada:  DE = puntero al XDPH de la unidad (no usado aqui -- ya
;              tenemos todo lo necesario en @adrv/@rdrv/@trk/@sect/
;              @dma/@dbnk, que BIOSKRNL ya deja preparados).
;    Salida:   A = 0 (OK), 1 (error permanente), 2 (protegido contra
;              escritura, solo WRITE -- no lo usamos).
;
;  Las unidades SD (A-D) reutilizan el protocolo de sddisk.z80 (2.2,
;  comandos MCU 0x35-0x39) sin cambios; lo unico nuevo es el paso por
;  @bnkbf (banco comun, 128 B -- coincide exactamente con el tamano de
;  sector) para llegar a (@dma) cuando esta en un banco distinto del
;  actual (@dbnk <> @cbnk), igual que hace ramdisk_read/write con el
;  disco RAM. Sin este paso, escribir directamente en (@dma) fallaria
;  en cuanto el llamador este en un banco distinto al que ve el driver.
; =====================================================================

;            public sd_read,sd_write,sd_login,sd_init
;            public ram_read,ram_write,ram_login,ram_init
;            extrn  @adrv,@rdrv,@trk,@sect,@dma,@dbnk,@cbnk
;            extrn  ?bank,@bnkbf
            include "memmap.inc"

; ---------------------------------------------------------------------
;  SD (unidades A-D) -- protocolo MCU 0x35-0x39, igual que sddisk.z80
; ---------------------------------------------------------------------

sd_init:    ret                 ; nada que hacer: el fopen es perezoso,
                                 ; ocurre en sd_login (primer select)

sd_login:   ld   a,(@rdrv)
            push af
            ld   hl,diskname_a
            or   a
            jr   z, sdl_open
            ld   hl,diskname_b
            dec  a
            jr   z, sdl_open
            ld   hl,diskname_c
            dec  a
            jr   z, sdl_open
            ld   hl,diskname_d
sdl_open:   call sd_fopen            ; A = handle (0FFh si no existe)
            ld   b,a
            pop  af                  ; A = @rdrv otra vez
            ld   e,a
            ld   d,0
            ld   hl,disk_handle
            add  hl,de
            ld   (hl),b
            ret

; curhandle_sd - A = handle SD de la unidad @rdrv (0-3)
curhandle_sd:
            ld   a,(@rdrv)
            ld   e,a
            ld   d,0
            ld   hl,disk_handle
            add  hl,de
            ld   a,(hl)
            ret

sd_read:    call compute_offset
            call curhandle_sd
            call sd_fseek
            ld   de,128
            ld   hl,@bnkbf
            call sd_fread            ; A=status (0 OK, 1 short/EOF)
            push af
            ; --- @bnkbf -> (@dma) en banco @dbnk ---
            ld   a,(@dbnk)
            call ?bank
            ld   hl,@bnkbf
            ld   de,(@dma)
            ld   bc,128
            ldir
            ld   a,(@cbnk)
            call ?bank               ; restaura
            pop  af
            or   a
            ret  z
            ld   a,1
            ret

sd_write:   ; --- (@dma) en banco @dbnk -> @bnkbf ---
            ld   a,(@dbnk)
            call ?bank
            ld   hl,(@dma)
            ld   de,@bnkbf
            ld   bc,128
            ldir
            ld   a,(@cbnk)
            call ?bank               ; restaura

            call compute_offset
            call curhandle_sd
            call sd_fseek
            ld   de,128
            ld   hl,@bnkbf
            call sd_fwrite           ; A=status (0 OK)
            or   a
            ret  z
            ld   a,1
            ret

; compute_offset - sd_off = (@trk*26 + @sect) * 128, igual que en el 2.2
; (bios.z80/sddisk.z80), solo que lee @trk/@sect (de BIOSKRNL) en vez de
; las variables trk/sec propias del 2.2.
compute_offset:
            ld   de,(@trk)
            ld   a,26
            ld   hl,0
            ld   b,8
co_mul:     add  hl,hl
            rlca
            jr   nc,co_ms
            add  hl,de
co_ms:      djnz co_mul
            ld   de,(@sect)
            add  hl,de               ; HL = lba = trk*26 + sect
            ld   d,0
            ld   b,7
co_shl:     add  hl,hl
            rl   d
            djnz co_shl
            ld   (sd_off),hl
            ld   a,d
            ld   (sd_off+2),a
            xor  a
            ld   (sd_off+3),a
            ret

; ---------------------------------------------------------------------
;  Disco RAM (unidad E) -- map1blk + ventana, ver memory_map.md
; ---------------------------------------------------------------------

ram_init:   ret
ram_login:  ret

; map1blk se declara en bank.z80 (banco 3 duplicado); aqui solo extrn.
;            extrn  map1blk

rd$winaddr: ds   2              ; direccion Z80 real de la ventana
rd$rdpage:  ds   1              ; pagina fisica del disco RAM (trk+base)
rd$normpage: ds  1              ; pagina "normal" del banco ventana en
                                 ; el contexto actual, para restaurarla

; rdx$setup - calcula rd$winaddr/rd$rdpage/rd$normpage a partir de
; @trk, @sect, @cbnk. No mapea nada todavia. Solo se llama desde
; ram_read/ram_write, siempre con "sistema" activo (invocadas desde
; BDOS), asi que no necesita vivir en la zona duplicada de bank.z80.
rdx$setup:  ld   a,(@trk)
            add  a,RAMDISK_BASE
            ld   (rd$rdpage),a

            ld   a,(@sect)
            ld   l,a
            ld   h,0
            add  hl,hl
            add  hl,hl
            add  hl,hl
            add  hl,hl
            add  hl,hl
            add  hl,hl
            add  hl,hl               ; HL = @sect*128
            ld   de,WINBLK*2000h     ; base Z80 del banco ventana
            add  hl,de
            ld   (rd$winaddr),hl

            ld   a,(@cbnk)
            ld   d,BANK0_BASE
            or   a
            jr   z, rdx$s0
            ld   d,BANK1_BASE
rdx$s0:     ld   a,d
            add  a,WINBLK
            ld   (rd$normpage),a
            ret

ram_read:   call rdx$setup

            ld   a,(rd$rdpage)
            ld   e,WINBLK
            call map1blk
            ld   hl,(rd$winaddr)
            ld   de,@bnkbf
            ld   bc,128
            ldir
            ld   a,(rd$normpage)
            ld   e,WINBLK
            call map1blk             ; restaura

            ld   a,(@dbnk)
            call ?bank
            ld   hl,@bnkbf
            ld   de,(@dma)
            ld   bc,128
            ldir
            ld   a,(@cbnk)
            call ?bank               ; restaura
            xor  a                   ; siempre OK
            ret

ram_write:  call rdx$setup

            ld   a,(@dbnk)
            call ?bank
            ld   hl,(@dma)
            ld   de,@bnkbf
            ld   bc,128
            ldir
            ld   a,(@cbnk)
            call ?bank               ; restaura

            ld   a,(rd$rdpage)
            ld   e,WINBLK
            call map1blk
            ld   hl,@bnkbf
            ld   de,(rd$winaddr)
            ld   bc,128
            ldir
            ld   a,(rd$normpage)
            ld   e,WINBLK
            call map1blk             ; restaura
            xor  a                   ; siempre OK
            ret

; ---------------------------------------------------------------------
;  Variables (zona comun -- datos, no codigo)
; ---------------------------------------------------------------------
disk_handle: defs 4               ; handle SD por unidad (A-D)
sd_off:      defs 4
sd_handle:   defs 1               ; scratch temporal, usa sddisk.z80

diskname_a: defb 'A.IMG',0
diskname_b: defb 'B.IMG',0
diskname_c: defb 'C.IMG',0
diskname_d: defb 'D.IMG',0

; CSV/ALV por unidad (scratch del BDOS, no son datos de disco). ALV va
; a doble bit por bloque -- obligatorio en CP/M 3 banked (a diferencia
; del 2.2, que usaba 1 bit/bloque -- alv0-3 de 31 B en bios.z80 no
; sirven tal cual aqui). E (disco RAM) es medio fijo (CKS=8000h en
; dpb_ram), asi que no lleva CSV -- nos ahorramos ese buffer.
;            public csv_a,csv_b,csv_c,csv_d
;            public alv_a,alv_b,alv_c,alv_d,alv_e

csv_a:      defs 16                ; (DRM/4)+1 = (63/4)+1, redondeado
csv_b:      defs 16
csv_c:      defs 16
csv_d:      defs 16

alv_a:      defs 63                ; (DSM/4)+2 = (242/4)+2, doble bit
alv_b:      defs 63
alv_c:      defs 63
alv_d:      defs 63
alv_e:      defs 14                ; (DSM/4)+2 = (48/4)+2, disco RAM

; mcu_send/mcu_recv/sd_fopen/sd_fseek/sd_fread/sd_fwrite/sd_fclose y la
; variable sd_handle (protocolo MCU, sin cambios respecto al 2.2)
            include "sddisk.z80"
