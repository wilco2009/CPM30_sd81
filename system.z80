; =====================================================================
;  system.z80 - primer ensamblado conjunto de CP/M+ SD81: BIOSKRNL.ASM
;  (nucleo de DRI) + todo nuestro XIOS. SIN CCP/BDOS todavia (no estan
;  ensamblados) -- objetivo de esta primera prueba: llegar a ?boot ->
;  boot: -> ?init (video+FULL_PAGING+duplicar switcher) -> bucles de
;  ?cinit/INIT de disco (no-op) -> ?ldccp (stub: mensaje + parado).
;
;  Terreno nuevo: hasta ahora BIOSKRNL.ASM solo se probo ensamblado en
;  aislado (--rel, ver build_bioskrnl.bat). Esta es la primera vez que
;  se combina con el resto -- puede que salga algun error de
;  compatibilidad nuevo (cseg/dseg/public/extrn en un ensamblado
;  absoluto de un solo fichero, no relocatable).
;
;  Ensamblar: zmac --od . --oo cim,lst system.z80
;  Cargar (desde BASIC):
;    LOAD THEN CLEAR 24575
;    LOAD FAST "SYSTEM.BIN" CODE 24576
;    RAND USR 24576
; =====================================================================

            org  06000h

; -----------------------------------------------------------------------
;  start - activa MC45 ANTES de saltar a ?boot. Sin esto la CPU no puede
;  ejecutar codigo en la mitad alta del mapa (A15=1, >=$8000) -- que es
;  donde cae casi todo nuestro XIOS (init.z80, chario.z80...) una vez
;  ensamblado detras de BIOSKRNL.ASM/SCB.ASM. Confirmado en hardware
;  real: sin activar MC45 se leian NOP en vez de las instrucciones
;  reales por encima de $8000 (bytes correctos en el .bin, ver
;  memory_map.md).
;
;  boot_mcu_send es una copia MINIMA e independiente de in_mcu_send
;  (init.z80): esa vive por encima de $8000 y no se puede llamar
;  todavia -- justo el problema que este bloque resuelve.
; -----------------------------------------------------------------------
start:      ld   a,013h          ; comando MCU: MC45 ON (48K mode)
            call boot_mcu_send

            ; mc45_ext67: MC45 por defecto solo cubre los bloques 4 y 5
            ; ($8000-$BFFF). El 6 y el 7 hay que habilitarlos aparte, y
            ; TIENE QUE SER AQUI, no en ?init como estaba antes: desde que
            ; la zona duplicada se mudo a $DE00, "?boot" vive en el bloque
            ; 6 -- o sea que el "jp" de abajo ya necesita que sea
            ; ejecutable. Hacerlo en ?init era imposible: a ?init solo se
            ; llega pasando por ?boot.
            ;
            ; Sintoma cuando faltaba: el RAND USR volvia a BASIC sin mas.
            ; La CPU leia basura en $DE6C en vez de ?boot.
            ;
            ; Es escritura a registro MMIO, y la ventana MMIO sigue
            ; abierta en este punto -- la cierra ?init mucho despues, con
            ; "ld (2056),a".
            ld   a,170
            ld   (2062),a

            jp   ?boot           ; BASIC "RAND USR 24576" entra aqui

boot_mcu_send:
            ld   b,a
            in   a,(0AFh)
            ld   c,a
            ld   a,b
            out  (0A7h),a
            ld   a,c
            cpl
            ld   c,a
bms_wait:   in   a,(0AFh)
            xor  c
            jp   m, bms_wait
            ret

; Constantes del mapa de memoria. Va AQUI ARRIBA, y no solo donde lo
; incluyen bank.z80/diskio.z80, porque BIOSKRNL.ASM ya necesita BIOSTBL
; (set$jumps) y se ensambla antes que ninguno de los dos. Son solo
; "equ": no emite un byte.
            include "memmap.inc"

            .8080                ; BIOSKRNL.ASM/SCB.ASM son fuente DRI (8080)
            include "BIOSKRNL.ASM"
            include "SCB.ASM"
            .z80                 ; el resto de ficheros son Z80 puro (jr/djnz/...)

            include "bank.z80"
            include "move.z80"
            include "diskio.z80"

; El reloj va DESPUES de diskio.z80: usa mcu_send/mcu_recv/sd_clk, que
; los define sddisk.z80 al final de ese fichero.
            include "rtc.z80"
            include "drvtbl.z80"
            include "chario.z80"
            include "init.z80"

; -----------------------------------------------------------------------
;  BDOS.ASM + RESBDOS.ASM (banked, real de DRI) -- van al final en orden
;  de FUENTE a proposito, aunque su propio "org 0000h" los coloca en
;  memoria muy por debajo de todo lo anterior ($0000-$33xx, banco 0-2 de
;  sistema, completamente libres hasta ahora). El orden de aparicion en
;  el fuente (no la direccion final) es lo que importa para que sus
;  alias "equ" hacia ?boot..?xmov (bank.z80) sean referencia HACIA
;  ATRAS -- ver memory_map.md, la nota sobre inestabilidad de fase con
;  "equ" hacia delante (nos costo una buena sesion de depuracion).
; -----------------------------------------------------------------------
; CPM3_SD81: guarda de tamano del XIOS. BDOS.ASM empieza con un "org
; 08A00h" absoluto, y dos "org" que se solapan NO dan error: el segundo
; simplemente pisa al primero en silencio. Con esto, si el XIOS creciera
; por encima de $8A00 el "ds" sale negativo y el ensamblado falla.
; Subido de $8900 a $8A00 al sacar move.z80 del bloque duplicado: el XIOS
; se desplazo ~228 bytes y se pasaba por 38.
            ds   08A00h-$

            .8080
            include "BDOS.ASM"
            include "RESBDOS.ASM"

; CPM3_SD81: alias que BDOS.ASM necesita pero solo se pueden resolver
; aqui (referencia hacia atras de verdad, con los dos ficheros ya
; incluidos) -- ver la nota en BDOS.ASM junto a "bios equ ?boot".
xdmaad		equ	xdmaadd
srch$hash	equ	rb$search$hash

            include "ccp_image.z80"

; ---------------------------------------------------------------------
;  Vectores de asignacion (ALV), en memoria comun para que la funcion 27
;  devuelva una direccion que el programa que pregunta pueda leer.
;  No se emite nada util -- son buffers que rellena la BDOS en marcha --
;  pero se reservan explicitamente para que nadie se cuele en el hueco.
;  Ver la nota larga en memmap.inc.
; ---------------------------------------------------------------------
alv$save    equ  $
            org  ALV_BASE
            ds   4*ALV_SD + ALV_RAM
            ds   0F598h-$        ; guarda: no puede llegar al BIOS
            org  alv$save

; ---------------------------------------------------------------------
;  CPM3_SD81: aqui se reservaban los ALV (ds ALV_BASE-$ / ds 4*ALV_SD +
;  ALV_RAM). Se han ido al banco 7 -- ver memmap.inc y layout_dri.md --
;  asi que lo unico que queda es rellenar hasta BKIOEXT. La guarda sigue
;  sirviendo para lo mismo: falla si la imagen de la CCP creciera hasta
;  aqui. Dos "org" que se pisan no dan error en zmac, asi que esto es lo
;  unico que lo detecta, ademas de checkimg.py.
; ---------------------------------------------------------------------
            ds   BKIOEXT-$       ; para AQUI, no en LDR_BASE: detras esta
                                  ; el bloque de E/S que BIOSKRNL.ASM ya
                                  ; escribio con su propio "org", y este
                                  ; "ds" se lo rellenaria encima.

; Cargador de transitorios. Va DESPUES de init.z80 porque salta a
; call5_entry, y despues de ccp_image.z80 porque se ensambla en $DF00,
; por encima de la imagen de la CCP ($BD00-$C700).
;
; OJO con el ".z80": aqui seguia activo el ".8080" de BDOS.ASM/RESBDOS
; (linea 84). ccp_image.z80 no se entera porque solo tiene "db", pero
; loader.z80 es Z80 puro y en modo 8080 no ensambla ni una linea -- el
; sintoma fue un system.bin de 0 bytes.
            .z80
            include "loader.z80"
            .8080

; Tabla de fuentes de 256 caracteres, ensamblada directamente en $F800
; (banco 7). Va la ultima porque es lo mas alto del mapa; el .cim es
; plano y se carga desde $6000, asi que el cargador la deja ya puesta y
; ?init solo tiene que apuntar el registro I. Generada -- ver la
; cabecera del fichero.
            include "font_image.z80"

            end
