; =====================================================================
;  NETTIME.Z80 - donde se va el tiempo en el camino de red del Z80.
;
;  Contexto: la traza del emulador demostro que el Z80 tarda ~655 ms en
;  consumir 128 bytes (5,1 ms por byte, unos 16.500 ciclos), mientras el
;  emulador entrega los datos en microsegundos en cuanto se los piden.
;  O sea que el cuello de botella esta aqui, y hay que localizarlo.
;
;  TRES MODOS
;
;    NETTIME      coste de un comando MCU, sin datos ni conexion.
;                 Lanza NET_READ con max=0 (el "¿hay algo?" barato de la
;                 especificacion) y cuenta cuantos caben en 5 segundos.
;
;    NETTIME B    llamadas a la funcion 12. OJO: no es la funcion barata
;                 que parece. En el RESBDOS, "cpi diskfx / jnc disk$func"
;                 con diskfx=12 la manda por el camino de disco, o sea el
;                 cambio de banco al BDOS bancado. Sirve para medir ESE
;                 camino, no el andamiaje minimo.
;
;    NETTIME O    la funcion 8 (AUXOST). Mismo recorrido que la 7 pero
;                 SIN comando MCU: es el control que aisla cuanto cuesta
;                 el comando lanzado desde dentro del XIOS.
;
;    NETTIME C    la velocidad real del Z80, sin BDOS ni nada. Es la
;                 referencia que faltaba: sin ella no se pueden traducir
;                 los microsegundos a ciclos. Dio ~2,4 MHz.
;
;    NETTIME I    lo mismo pero con un IN por vuelta, para ver si una
;                 operacion de puerto cuesta lo que dice el Z80 o mucho
;                 mas. Salio normal: la E/S de puerto no es el problema.
;
;    NETTIME W    caracteres por segundo imprimiendo un punto.
;    NETTIME N    lo mismo con un caracter que ?co descarta sin pintar.
;                 La diferencia entre los dos es el coste de pintar.
;
;    NETTIME R    bytes por segundo LEYENDO de AUX y tirandolos.
;                 Mide el camino BDOS + driver, sin pintar nada.
;
;    NETTIME P    lo mismo, pero pintando cada byte en pantalla.
;
;  La diferencia entre R y P es lo que cuesta el terminal. Si R ya sale
;  lento, el problema esta en las llamadas al BDOS y en el driver, y
;  optimizar el pintado no serviria de nada.
;
;  R y P necesitan que este entrando algo: conecta con TERM, pide a la
;  BBS un listado largo, sal con ENTER+0 (la conexion vive en el
;  emulador, no se cae) y lanza esto enseguida.
;
;  OJO AL SEGUNDO NUMERO. Si se drena mas rapido de lo que la BBS manda,
;  lo que se mide es la velocidad de la BBS y no la nuestra. Por eso se
;  cuentan tambien los sondeos EN VACIO: si salen muchos, la medida no
;  vale y hay que buscar una fuente mas rapida.
;
;  COMO LEER LOS NUMEROS
;
;  Salen en hexadecimal. El primero es la cuenta (comandos en grupos de
;  16, o bytes sueltos); el segundo, los sondeos en vacio. Divide entre
;  5 para tener el ritmo por segundo.
;
;  El reloj se lleva mirando cuando CAMBIA el campo de segundos de la
;  funcion 105, no restando: viene en BCD y asi no hay que convertirlo.
;  Y solo se mira una vez cada TDIV vueltas, porque preguntar la hora es
;  otra llamada al BDOS y falsearia justo lo que se quiere medir.
;
;  AVISO: si el MCU no contesta, la espera de toggle es infinita y hay
;  que resetear. Es el mismo riesgo que cualquier comando MCU.
; =====================================================================

BDOS        equ  0005h
FCB         equ  005Ch

F_RESET     equ  0
F_CONOUT2   equ  2
F_AUXIN     equ  3
F_CONIO     equ  6
F_AUXIST    equ  7
F_AUXOST    equ  8         ; estado de salida de AUX (el control del modo O)
F_PRINT     equ  9
F_TIME      equ  105        ; CP/M 3: devuelve los segundos en A (BCD)

CIO_IN      equ  0FDh       ; 0FDh-0FFh no se pueden imprimir con la 6

DataPort    equ  0A7h
ClkPort     equ  0AFh
CMD_NET_RD  equ  66

SECONDS     equ  5          ; duracion de la medida
TDIV        equ  16         ; vueltas entre dos miradas al reloj

            org  0100h

start:      ld   a,(FCB+1)
            ld   (mode),a
            cp   'R'
            jp   z,rx_go
            cp   'P'
            jp   z,rx_go
            cp   'B'
            jp   z,bd_go
            cp   'O'
            jp   z,ao_go
            cp   'C'
            jp   z,cpu_go
            cp   'I'
            jp   z,io_go
            cp   'T'
            jp   z,t_go
            cp   'W'
            jp   z,w_go
            cp   'N'
            jp   z,n_go

; --- modo comando: cuanto cuesta un NET_READ vacio -------------------
            ld   de,msg_cmd
            ld   c,F_PRINT
            call BDOS
            call t_start
cm_loop:    ld   b,16               ; de 16 en 16, para no desbordar el
cm_16:      push bc                 ; contador de 16 bits
            call netpoll
            pop  bc
            djnz cm_16
            call bump
            call t_done
            jr   nc,cm_loop
            jp   report

; ---------------------------------------------------------------------
;  modo B: el camino bancado del BDOS.
;
;  Se eligio la funcion 12 (version del sistema) creyendo que seria la
;  llamada mas barata posible: devuelve dos bytes de una constante, sin
;  tocar discos ni dispositivos. Pero en el RESBDOS esta
;
;      cpi diskfx        ; diskfx equ 12
;      jnc disk$func
;
;  o sea que la 12 y todo lo que venga detras se van por el camino de
;  disco, con cambio de banco al BDOS bancado. Asi que esto NO mide el
;  andamiaje minimo: mide el camino pesado completo.
;
;  Sigue sirviendo, pero como referencia: da el coste de cruzar de banco,
;  para comparar con lo que cuesta el camino residente de AUX (7 y 8),
;  que no cruza nunca.
; ---------------------------------------------------------------------
bd_go:      ld   de,msg_bd
            ld   c,F_PRINT
            call BDOS
            call t_start
bd_loop:    ld   b,16
bd_16:      push bc
            ld   c,12               ; ...que resulta NO ser barata
            call BDOS
            pop  bc
            djnz bd_16
            call bump
            call t_done
            jr   nc,bd_loop
            jp   report

; ---------------------------------------------------------------------
;  modo O: el control para aislar el comando MCU.
;
;  La funcion 8 (AUXOST, estado de salida de AUX) recorre EXACTAMENTE el
;  mismo camino que la 7 -- RESBDOS residente, out$scan sobre @aovec,
;  biosw con su cambio de banco, banco de sistema -- pero acaba en
;  net_cost, y con el bufer de salida vacio net_flush vuelve sin hablar
;  con el MCU.
;
;  Asi que la diferencia entre la 7 y la 8 es, limpiamente, lo que cuesta
;  el comando MCU lanzado DESDE DENTRO del XIOS. Y eso se puede comparar
;  con los 0,24 ms que cuesta el mismo comando desde la TPA (modo por
;  defecto). Si no coinciden, el comando es mas caro dentro que fuera y
;  hay que preguntarse por que.
; ---------------------------------------------------------------------
ao_go:      ld   de,msg_ao
            ld   c,F_PRINT
            call BDOS
            call t_start
ao_loop:    ld   b,16
ao_16:      push bc
            ld   c,F_AUXOST
            call BDOS
            pop  bc
            djnz ao_16
            call bump
            call t_done
            jr   nc,ao_loop
            jp   report

; ---------------------------------------------------------------------
;  modo C: la velocidad REAL del Z80, sin BDOS, sin MCU, sin pantalla.
;
;  Todo el analisis de esta sesion traduce microsegundos a ciclos
;  suponiendo 3,25 MHz. Si esa suposicion es falsa, las conclusiones lo
;  son tambien -- y no se habia comprobado nunca.
;
;  El bucle interno es un djnz pelado: 13 ciclos por vuelta, 8 la ultima.
;  Con B=0 son 256 vueltas, o sea 256*13-5 = 3323 ciclos por grupo, y de
;  ahi sale la frecuencia:
;
;      MHz = cuenta * 3323 / 5 / 1.000.000
;
;  A 3,25 MHz la cuenta deberia salir alrededor de 1300 (0514h).
; ---------------------------------------------------------------------
cpu_go:     ld   de,msg_cpu
            ld   c,F_PRINT
            call BDOS
            call t_start
cpu_loop:   ld   b,0                ; 256 vueltas
cpu_in:     djnz cpu_in
            call bump
            call t_done
            jr   nc,cpu_loop
            jp   report

; ---------------------------------------------------------------------
;  modo I: cuanto cuesta de verdad una operacion de puerto.
;
;  El modo C dio ~2,4 MHz: el Z80 va bien. Pero abaratar ?bank en ciclos
;  no cambio el tiempo ni un digito, y cuando eso pasa es que el tiempo
;  no se iba en ciclos. El sospechoso es el OUT de paginado: si el
;  emulador lo resuelve recalculando el mapa de memoria por el lado del
;  anfitrion, cuesta tiempo real que NO aparece como ciclos del Z80 -- y
;  entonces quitar instrucciones alrededor no sirve de nada.
;
;  Aqui se mide con un IN al puerto de reloj, que es inofensivo (solo
;  lee) y no toca el paginado. Comparado con el modo C:
;
;      el bucle de C son 3323 ciclos por grupo (djnz pelado)
;      el de aqui son 6144 (in + djnz)
;
;  Asi que si la E/S de puerto fuera gratis, la cuenta deberia salir algo
;  mas de la mitad que en C, sobre 0790h. Si sale MUCHO menor, cada
;  operacion de puerto cuesta tiempo real de sobra para explicarlo todo,
;  y el trabajo no esta en el Z80 sino en el emulador.
; ---------------------------------------------------------------------
io_go:      ld   de,msg_io
            ld   c,F_PRINT
            call BDOS
            call t_start
io_loop:    ld   b,0
io_in:      in   a,(ClkPort)
            djnz io_in
            call bump
            call t_done
            jr   nc,io_loop
            jp   report

; ---------------------------------------------------------------------
;  modos W y N: cuanto cuesta IMPRIMIR un caracter.
;
;  TERMD.COM quito del medio TODO el camino de lectura -- un solo comando
;  MCU por cada 128 bytes, cero llamadas al BDOS -- y la velocidad no
;  cambio. Asi que lo unico que queda en el bucle es imprimir.
;
;  La cuenta que hay que explicar: 38 bytes/s son 26 ms por caracter, o
;  sea 85.000 ciclos. Escribir dos bytes en memoria de pantalla no cuesta
;  eso ni de lejos, asi que o la cuenta esta mal o pasa algo mas.
;
;    W  imprime un punto: camino completo, con pintado.
;    N  imprime un cero, que ?co descarta antes de pintar nada
;       ("cp 20h / ret c"). Mide el camino SIN el pintado.
;
;  La diferencia entre los dos es lo que cuesta pintar de verdad. Si W y
;  N salen parecidos, pintar es gratis y el coste esta en llegar hasta
;  ?co; entonces hay que comparar con el modo O, que es otra llamada al
;  BDOS que acaba en el XIOS pero sin tocar pantalla.
;
;  OJO: en W la pantalla se llena y hace scroll cada 80 caracteres. El
;  scroll son dos LDIR de ~1944 bytes, unos 25 ms, que repartidos entre
;  80 caracteres son 0,3 ms cada uno. Poco al lado de 26, pero conviene
;  saberlo antes de interpretar el numero.
; ---------------------------------------------------------------------
; ---------------------------------------------------------------------
;  modo T: comprobar el RELOJ, que es el instrumento de todo lo demas.
;
;  Hay dos sintomas que dicen que el cronometro no mide lo que creo:
;  el modo C dio exactamente el mismo numero antes y despues de arreglar
;  la espera al borde del segundo (tenia que haber subido hasta un 20%),
;  y los modos N y W dieron cero con el bucle claramente ejecutandose.
;
;  Todo el cronometro se apoya en que la funcion 105 del BDOS devuelva
;  los segundos en A. Si eso no es cierto en este sistema, ni una sola de
;  las medidas de hoy vale nada -- asi que se comprueba directamente:
;  se sondea la hora y se imprime cada valor NUEVO, ocho veces.
;
;  Lo que se espera ver: 00 01 02 03... en BCD, subiendo de uno en uno y
;  a razon de uno por segundo. Cualquier otra cosa (valores repetidos,
;  saltos, basura) explica de golpe todos los numeros raros.
; ---------------------------------------------------------------------
t_go:       ld   de,msg_clk
            ld   c,F_PRINT
            call BDOS
            ld   b,8                ; ocho valores distintos
            call getsec
            ld   (lastsec),a
tg_wait:    call getsec
            ld   hl,lastsec
            cp   (hl)
            jr   z,tg_wait
            ld   (hl),a
            push bc
            call put_hex
            ld   e,' '
            ld   c,F_CONOUT2
            call BDOS
            pop  bc
            djnz tg_wait
            ld   de,msg_nl
            ld   c,F_PRINT
            call BDOS
            ld   c,F_RESET
            jp   BDOS

w_go:       ld   a,'.'
            jr   wn_go
n_go:       xor  a
wn_go:      ld   (wn_char),a
            ld   de,msg_wn
            ld   c,F_PRINT
            call BDOS
            call t_start
wn_loop:    ld   b,16
wn_16:      push bc
            ld   a,(wn_char)
            ld   e,a
            ld   c,F_CONIO
            call BDOS
            pop  bc
            djnz wn_16
            call bump
            call t_done
            jr   nc,wn_loop
            jp   report

; --- modos R y P: drenar AUX y contar bytes --------------------------
rx_go:      ld   de,msg_rx
            ld   c,F_PRINT
            call BDOS
            call t_start
rx_loop:    ld   c,F_AUXIST
            call BDOS
            or   a
            jr   nz,rx_data
            ld   hl,(empty)         ; sondeo en vacio: la fuente no da mas
            inc  hl
            ld   (empty),hl
            jr   rx_next
rx_data:    ld   c,F_AUXIN
            call BDOS
            ld   e,a
            ld   a,(mode)
            cp   'P'
            call z,conout
            call bump
rx_next:    call t_done
            jr   nc,rx_loop

; ---------------------------------------------------------------------
report:     ld   de,msg_res
            ld   c,F_PRINT
            call BDOS
            ld   hl,(count)
            call put_hl
            ld   de,msg_emp
            ld   c,F_PRINT
            call BDOS
            ld   hl,(empty)
            call put_hl
            ld   de,msg_tail
            ld   c,F_PRINT
            call BDOS
            ld   c,F_RESET
            jp   BDOS

; ---------------------------------------------------------------------
;  t_start / t_done - el cronometro. t_done pone acarreo cuando se han
;  cumplido los SECONDS segundos.
; ---------------------------------------------------------------------
;  ESPERAR AL BORDE DEL SEGUNDO NO ES OPCIONAL.
;
;  Si se empieza a contar a mitad de segundo, el primer cambio del campo
;  de segundos llega enseguida: se miden poco mas de 4 segundos de
;  trabajo y luego se divide entre 5. El error llega al 20% POR DEFECTO,
;  y TODAS las cifras salen bajas.
;
;  La primera version de este programa si esperaba al borde; se perdio al
;  refactorizar el cronometro, y por eso la medida de la CPU daba 2,4 MHz
;  cuando las trazas del emulador dan 3,21 -- que es lo correcto.
t_start:    call getsec
            ld   (lastsec),a        ; en MEMORIA, no en un registro: por
ts_edge:    call getsec             ; aqui pasan llamadas al BDOS
            ld   hl,lastsec
            cp   (hl)
            jr   z,ts_edge          ; girar hasta el borde del segundo
            ld   (lastsec),a
            ld   hl,0
            ld   (count),hl
            ld   (empty),hl
            xor  a
            ld   (secs),a
            ld   a,TDIV
            ld   (tcnt),a
            ret

;  Convenio: vuelve con ACARREO PUESTO cuando se acabo el tiempo.
t_done:     ld   a,(tcnt)
            dec  a
            ld   (tcnt),a
            jr   z,td_check
td_go:      or   a                  ; acarreo a 0 = seguir
            ret
td_check:   ld   a,TDIV
            ld   (tcnt),a
            call getsec
            ld   hl,lastsec
            cp   (hl)
            jr   z,td_go            ; el segundo no ha cambiado
            ld   (hl),a
            ld   a,(secs)
            inc  a
            ld   (secs),a
            cp   SECONDS            ; acarreo si aun faltan segundos...
            ccf                     ; ...asi que se invierte
            ret
bump:       ld   hl,(count)
            inc  hl
            ld   (count),hl
            ret

; ---------------------------------------------------------------------
;  netpoll - NET_READ con max=0: el comando mas barato que existe, asi
;  que lo que se mide es su coste fijo, sin transferencia.
; ---------------------------------------------------------------------
netpoll:    in   a,(ClkPort)        ; C = reloj actual (como sd_clk)
            ld   c,a
            ld   a,CMD_NET_RD
            call mcu_send
            xor  a
            call mcu_send           ; max = 0
            call mcu_recv           ; count (sera 0)
            call mcu_recv           ; avail
            call mcu_recv           ; status
            ret

mcu_send:   out  (DataPort),a
            ld   a,c
            cpl
            ld   c,a
ms_w:       in   a,(ClkPort)
            xor  c
            jp   m,ms_w
            ret

mcu_recv:   in   a,(DataPort)
            push af
            ld   a,c
            cpl
            ld   c,a
mr_w:       in   a,(ClkPort)
            xor  c
            jp   m,mr_w
            pop  af
            ret

; ---------------------------------------------------------------------
conout:     ld   a,e                ; imprime E sin tocarlo
            cp   CIO_IN
            jr   nc,co_slow
            ld   c,F_CONIO
            jp   BDOS
co_slow:    ld   c,F_CONOUT2
            jp   BDOS

;  El push/pop NO es decorativo: aqui se pone C para la llamada y el
;  BDOS destruye BC al volver. Sin esto, getsec se lleva por delante el
;  contador de vueltas de quien la llama. Estaba en la primera version y
;  se perdio al refactorizar el cronometro; el sintoma fue que el modo T
;  no terminaba nunca y que la espera al borde del segundo no esperaba.
getsec:     push bc
            push de
            ld   de,tbuf
            ld   c,F_TIME
            call BDOS               ; A = segundos, en BCD
            pop  de
            pop  bc
            ret

put_hl:     ld   a,h
            call put_hex
            ld   a,l
put_hex:    push af
            rra
            rra
            rra
            rra
            call put_nib
            pop  af
put_nib:    and  00Fh
            add  a,'0'
            cp   '9'+1
            jr   c,ph_out
            add  a,7
ph_out:     ld   e,a
            ld   c,F_CONOUT2
            jp   BDOS

; ---------------------------------------------------------------------
mode:       defb 0
count:      defw 0
empty:      defw 0
secs:       defb 0
tcnt:       defb TDIV
lastsec:    defb 0
tbuf:       defs 4                  ; fecha y hora de la funcion 105

msg_cmd:    defb 13,10,'NETTIME: comandos MCU, 5 segundos...',13,10,'$'
msg_rx:     defb 13,10,'NETTIME: bytes de AUX, 5 segundos...',13,10,'$'
msg_bd:     defb 13,10,'NETTIME: llamadas BDOS, 5 segundos...',13,10,'$'
msg_ao:     defb 13,10,'NETTIME: AUXOST (sin MCU), 5 segundos...',13,10,'$'
msg_cpu:    defb 13,10,'NETTIME: velocidad del Z80, 5 segundos...',13,10,'$'
msg_io:     defb 13,10,'NETTIME: E/S de puerto, 5 segundos...',13,10,'$'
msg_wn:     defb 13,10,'NETTIME: salida a consola, 5 segundos...',13,10,'$'
msg_clk:    defb 13,10,'NETTIME: reloj, 8 segundos...',13,10,'$'
msg_nl:     defb 13,10,'$'
wn_char:    defb 0
msg_res:    defb 13,10,'cuenta: $'
msg_emp:    defb '  sondeos en vacio: $'
msg_tail:   defb 13,10,'(hexadecimal; divide entre 5)',13,10,'$'

            end  start
