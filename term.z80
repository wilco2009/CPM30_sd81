; =====================================================================
;  TERM.Z80 - terminal para el puente de red, con volcado opcional a
;  fichero.
;
;  Habla con el MCU directamente (comandos 66/67), sin AUX:, sin BDOS,
;  sin RESBDOS. Es una decision deliberada, no un descuido:
;
;  La version anterior pasaba por AUX: (funciones 7/3 del BIOS, AUXIST/
;  AUXIN) para respetar "DEVICE AUX:=NET" y poder valer, en teoria, para
;  cualquier cosa que se asignara a AUX. Pero AUXIST/AUXIN son rutinas de
;  BIOSKRNL.ASM, y BIOSKRNL.ASM vive en memoria BANCADA -- para poder
;  siquiera EJECUTAR esas instrucciones hace falta "sistema" activo, sin
;  importar a que dispositivo llamen luego por dentro. Eso son DOS
;  cruces de banco (biosw completo, ida y vuelta) por cada byte leido,
;  ademas del que ya hace falta para imprimir. Medido: ~195-400 B/s
;  contra los ~1100 B/s de hablar con el MCU a pelo.
;
;  No hay componenda que evite esto y seguir siendo generico: la propia
;  abstraccion (poder hablar con "lo que sea que este en AUX") ES lo que
;  obliga a pasar por BIOSKRNL. Duplicar las primitivas de net.z80 en la
;  zona comun no arregla nada -- el cambio de banco no es por net.z80,
;  es por auxist/auxin mismas.
;
;  Asi que la eleccion es binaria: generico y lento, o NET y rapido. Se
;  elige rapido, a proposito, porque para eso es este programa. Si algun
;  dia hace falta un terminal que valga con cualquier dispositivo AUX
;  (un puerto serie de verdad, por ejemplo), sera OTRO programa -- el
;  coste de la generalidad no tiene por que pagarlo el que solo necesita
;  hablar con NET.
;
;  Uso:
;      TERM            <- terminal a secas
;      TERM LOG.BIN    <- ademas, guarda TODO lo que llega
;
;  Se sale con la tecla de EXITKEY (ver abajo). NO hace falta "DEVICE
;  AUX:=NET": este programa no usa AUX para nada.
;
;  LAS CUATRO PRIMITIVAS DEL MCU
;
;  net_read/net_write y sus tres ayudantes (sd_clk/mcu_send/mcu_recv)
;  son identicas a las de net.z80 -- mismo protocolo, mismas trampas del
;  handshake (C es el reloj, A no sobrevive a mcu_send). Estan
;  duplicadas aqui, no compartidas con net.z80/chario.z80: este programa
;  vive en la TPA y esas viven en el banco de sistema, en direcciones
;  que no son las mismas en los dos contextos.
;
;  net_read pide hasta 128 bytes de una, el bufer entero del MCU: un
;  comando por rafaga en vez de uno por byte. net_write manda la tecla
;  en el momento, sin acumular -- para una tecla suelta no compensa.
;
;  LA IMPRESION TAMPOCO PASA POR EL BDOS
;
;  BIOS_CONOUT es la entrada CONOUT de la tabla publica de DRI
;  (loader.z80, bios$tbl -> BIOSTBL=$FF00; CONOUT es la entrada 4, o sea
;  $FF0C -- lo confirma el contrato de RESBDOS.ASM, "conoutf equ
;  bios$pg+12"). Vive en banco 7 (comun) y salta a la zona duplicada,
;  que cambia a "sistema" y llama al conout de verdad. Es la misma
;  tecnica que usan WordStar y Turbo Pascal para ir rapido en consola.
;
;  De regalo, no hay reserva de 0FDh-0FFh (la que tenia la funcion 6 del
;  BDOS, por multiplexar "caracter" y "peticion de entrada" en el mismo
;  registro): esos tres bytes -- zona alta de CP437 -- se imprimen igual
;  que cualquier otro.
;
;  EL VOLCADO
;
;  Guarda los bytes crudos, sin filtrar ni traducir: es para ver que
;  secuencias de escape manda la otra punta y cuales no entendemos. El
;  nombre sale del FCB que el propio CP/M ya ha rellenado en $005C con
;  el primer argumento, asi que no hay que parsear nada. Arranca APAGADO
;  aunque se haya dado nombre de fichero (ENTER+8 para encenderlo): lo
;  que interesa diagnosticar suele estar al final de la sesion, detras
;  de kilobytes de arte ANSI que no aportan nada.
;
;  AVISO: escribir en disco lleva su tiempo, y mientras tanto no se lee
;  del MCU. El bufer de entrada del MCU son 2 KB, asi que en una rafaga
;  larga se pueden perder bytes -- justo despues de un registro escrito.
;  Para diagnosticar secuencias de escape da igual, pero no te fies del
;  volcado como copia fiel de una descarga completa.
; =====================================================================

BDOS        equ  0005h
FCB         equ  005Ch      ; el CP/M ya ha metido aqui el primer argumento

F_RESET     equ  0          ; volver al CCP
F_CONOUT2   equ  2          ; solo la usa put_hex, para el codigo de error
F_CONIO     equ  6          ; E/S directa de consola (solo teclado aqui)
F_PRINT     equ  9          ; imprimir cadena terminada en el dolar
F_CLOSE     equ  16
F_DELETE    equ  19
F_WRITE     equ  21
F_MAKE      equ  22
F_DMA       equ  26

CIO_STAT    equ  0FEh       ; ...E=0FEh -> 0FFh si hay tecla
CIO_IN      equ  0FDh       ; ...E=0FDh -> leer tecla (bloquea)

DataPort    equ  0A7h
ClkPort     equ  0AFh
CMD_NET_RD  equ  66
CMD_NET_WR  equ  67

RXMAX       equ  128        ; lo que cabe en un solo NET_READ

; La entrada CONOUT de la tabla publica de DRI. Ver la nota de la
; cabecera. $FF00 (BIOSTBL) + 4*3 (CONOUT es la quinta entrada, index 4,
; de 3 bytes cada una) = $FF0C. Fija para cualquier build de este
; sistema -- BIOSTBL es un contrato estable, a diferencia de las
; direcciones internas de bank.z80, que se mueven si el fichero cambia.
BIOS_CONOUT equ  0FF0Ch

; Tecla de salida. ^] es el estandar de telnet, pero si en el teclado
; del ZX81 no hay forma comoda de teclearla, cambia este valor por algo
; que si se pueda -- teniendo en cuenta que esa tecla deja de poder
; mandarse al otro lado.
EXITKEY     equ  01Dh       ; Ctrl-]   (ENTER+0 en el teclado del ZX81)

; Conmutador de eco local (el "duplex" de toda la vida).
;
; El otro lado hace eco remoto de lo que tecleas, asi que con eco local
; permanente verias cada letra dos veces. Pero antes de conectar no hay
; nadie al otro lado que haga el eco, y se teclea el ATDT a ciegas. De
; ahi que sea un conmutador y no una opcion fija, igual que en todos los
; terminales de la epoca.
;
; Arranca APAGADO: lo normal es pasar mas rato conectado que marcando, y
; ver doble molesta mas que teclear a ciegas doce caracteres.
;
; La alternativa buena es ATE1, que deja el eco en manos del modem: lo
; hace en modo comando y lo quita al conectar, sin que el terminal tenga
; que saber nada. Esto de aqui funciona ademas cuando no hay interprete
; AT al otro lado.
ECHOKEY     equ  01Ch       ; Ctrl-\   (ENTER+9)

; Conmutador del volcado. Ver la nota de la cabecera.
LOGKEY      equ  01Eh       ; Ctrl-^   (ENTER+8)

            org  0100h

start:      ld   de,msg_on
            ld   c,F_PRINT
            call BDOS
            call log_open

; ---------------------------------------------------------------------
;  Bucle principal. Cada vuelta pide hasta 128 bytes de una (un unico
;  comando MCU), los imprime, y mira el teclado -- todo sin bloquear en
;  ninguna direccion.
; ---------------------------------------------------------------------
loop:       ld   hl,rxbuf
            ld   b,RXMAX
            call net_read           ; B = cuantos ha traido de verdad
            ld   a,b
            or   a
            jr   z,do_kbd           ; nada: directo al teclado
            ld   c,a                 ; C = cuantos quedan por imprimir/grabar
            ld   hl,rxbuf
pr_loop:    ld   a,(hl)
            push hl
            push bc
            ld   (rxbyte),a
            ld   c,a
            call BIOS_CONOUT         ; imprimir SIN pasar por el BDOS
            ld   a,(rxbyte)
            call log_byte
            pop  bc
            pop  hl
            inc  hl
            dec  c
            jr   nz,pr_loop

do_kbd:     ld   c,F_CONIO          ; hay tecla?
            ld   e,CIO_STAT
            call BDOS
            or   a
            jr   z,loop
            ld   c,F_CONIO          ; si: leerla
            ld   e,CIO_IN
            call BDOS
            cp   EXITKEY
            jr   z,done
            cp   ECHOKEY
            jr   z,do_echo
            cp   LOGKEY
            jr   z,do_log
            ld   (txbyte),a
            ld   hl,txbyte
            ld   b,1
            call net_write          ; mandarla, tambien sin pasar por CP/M
            ld   a,(localecho)
            or   a
            jr   z,loop
            ld   a,(txbyte)         ; y, si toca, pintarla aqui tambien
            ld   c,a
            call BIOS_CONOUT
            cp   00Dh               ; al otro lado va solo el CR, pero en
            jr   nz,loop            ; pantalla hace falta el LF o se
            ld   c,00Ah             ; reescribe encima de la misma linea
            call BIOS_CONOUT
            jp   loop

; --- conmutar el eco local, y decir como ha quedado -------------------
do_echo:    ld   a,(localecho)
            xor  1
            ld   (localecho),a
            ld   de,msg_eco_on
            or   a
            jr   nz,de_say
            ld   de,msg_eco_off
de_say:     ld   c,F_PRINT
            call BDOS
            jp   loop

; --- arrancar/parar el volcado ---------------------------------------
do_log:     ld   a,(logging)
            or   a
            jr   z,dl_none          ; no hay fichero: nada que conmutar
            ld   a,(logrec)
            xor  1
            ld   (logrec),a
            ld   de,msg_log_on
            or   a
            jr   nz,dl_say
dl_none:    ld   de,msg_log_off
dl_say:     ld   c,F_PRINT
            call BDOS
            jp   loop

done:       call log_close
            ld   de,msg_off
            ld   c,F_PRINT
            call BDOS
            ld   c,F_RESET
            jp   BDOS

; ---------------------------------------------------------------------
;  net_read  - lee hasta B bytes en (HL). Devuelve B = leidos.
;  net_write - envia B bytes desde (HL). Devuelve B = aceptados.
;
;  Identicas a las de net.z80. Ver la nota de la cabecera sobre C (el
;  reloj del handshake) y A (no sobrevive a mcu_send).
; ---------------------------------------------------------------------
net_read:   push hl
            ld   d,b
            call sd_clk
            ld   a,CMD_NET_RD
            call mcu_send
            ld   a,d
            call mcu_send           ; max
            call mcu_recv
            ld   b,a                ; count
            ld   d,a                ; copia a salvo (C es el reloj)
            or   a
            jr   z,nr_tail
nr_loop:    call mcu_recv
            ld   (hl),a
            inc  hl
            djnz nr_loop
nr_tail:    call mcu_recv           ; avail
            call mcu_recv           ; status (se ignora, ver net.z80)
            ld   b,d
            pop  hl
            ret

net_write:  call sd_clk
            ld   a,CMD_NET_WR
            call mcu_send
            ld   a,b
            call mcu_send           ; count
            ld   a,b                ; RECARGAR: mcu_send se ha comido A
            or   a
            jr   z,nw_tail
nw_loop:    ld   a,(hl)
            call mcu_send
            inc  hl
            djnz nw_loop
nw_tail:    call mcu_recv           ; aceptados
            ld   b,a
            call mcu_recv           ; status
            ret

sd_clk:     in   a,(ClkPort)
            ld   c,a
            ret

mcu_send:   out  (DataPort),a
            ld   a,c
            cpl
            ld   c,a
ms_w:       in   a,(ClkPort)
            xor  c
            jp   m,ms_w
            ret

mcu_recv:   in   a,(DataPort)
            push af
            ld   a,c
            cpl
            ld   c,a
mr_w:       in   a,(ClkPort)
            xor  c
            jp   m,mr_w
            pop  af
            ret

; ---------------------------------------------------------------------
;  log_open - si hay nombre en el FCB, crea el fichero. Si no lo hay, o
;  si no se puede crear, se sigue sin volcado: el terminal funciona
;  igual y no es cuestion de abortar la sesion por esto.
; ---------------------------------------------------------------------
log_open:   ld   a,(FCB+1)
            cp   020h               ; espacio: no habia argumento
            ret  z
            ld   de,FCB             ; borrar el anterior, si lo hubiera
            ld   c,F_DELETE
            call BDOS
            ld   de,FCB
            ld   c,F_MAKE
            call BDOS
            inc  a                  ; 0FFh = no se pudo crear
            jr   z,log_err
            ld   a,1
            ld   (logging),a        ; fichero listo; grabar, todavia no
            ret

; --- algo fallo: apagar el volcado y decir el codigo del BDOS --------
log_err:    push af
            xor  a
            ld   (logging),a
            ld   (logrec),a
            ld   de,msg_nolog
            ld   c,F_PRINT
            call BDOS
            pop  af
            ; y cae en put_hex

; --- A en dos digitos hexadecimales ----------------------------------
put_hex:    push af
            rra
            rra
            rra
            rra
            call put_nib
            pop  af
put_nib:    and  00Fh
            add  a,'0'
            cp   '9'+1
            jr   c,ph_out
            add  a,7                ; A-F
ph_out:     ld   e,a
            ld   c,F_CONOUT2
            jp   BDOS

; ---------------------------------------------------------------------
;  log_byte - mete A en el bufer; cuando se llenan los 128 B, lo escribe.
; ---------------------------------------------------------------------
log_byte:   ld   b,a
            ld   a,(logrec)
            or   a
            ret  z
            ld   a,(logcnt)
            ld   hl,logbuf
            ld   e,a
            ld   d,0
            add  hl,de
            ld   (hl),b
            inc  a
            ld   (logcnt),a
            cp   128
            ret  c
            ; el registro esta lleno: a disco

log_flush:  xor  a
            ld   (logcnt),a
            ld   de,logbuf          ; el DMA se pone en CADA escritura: el
            ld   c,F_DMA            ; BDOS lo mueve por su cuenta
            call BDOS
            ld   de,FCB
            ld   c,F_WRITE
            call BDOS
            or   a
            ret  z
            jp   log_err            ; disco lleno o error: apagar el volcado

; ---------------------------------------------------------------------
;  log_close - rellena el ultimo registro con ^Z y cierra.
; ---------------------------------------------------------------------
log_close:  ld   a,(logging)
            or   a
            ret  z
            xor  a
            ld   (logrec),a         ; no seguir grabando durante el cierre
            ld   a,(logcnt)
            or   a
            jr   z,lc_shut          ; el ultimo registro salio justo
            ld   hl,logbuf
            ld   e,a
            ld   d,0
            add  hl,de
            ld   a,128
            sub  e
            ld   b,a                ; B = lo que falta para los 128
lc_pad:     ld   (hl),01Ah
            inc  hl
            djnz lc_pad
            ld   a,128
            ld   (logcnt),a
            call log_flush
lc_shut:    ld   de,FCB
            ld   c,F_CLOSE
            jp   BDOS

; ---------------------------------------------------------------------
rxbyte:     defb 0                  ; el byte que se acaba de recibir
txbyte:     defb 0                  ; ...y el que se acaba de teclear
localecho:  defb 0                  ; 1 = eco local (media duplex)
logging:    defb 0                  ; 1 = hay fichero abierto y utilizable
logrec:     defb 0                  ; 1 = grabando ahora mismo (LOGKEY)
logcnt:     defb 0                  ; bytes ya metidos en el registro
logbuf:     defs 128
rxbuf:      defs RXMAX

msg_on:     defb 13,10,'TERM - con ENTER: 0 salir, 9 eco, 8 log',13,10,'$'
msg_log_on: defb 13,10,'[grabando]',13,10,'$'
msg_log_off:defb 13,10,'[log parado]',13,10,'$'
msg_eco_on: defb 13,10,'[eco local]',13,10,'$'
msg_eco_off:defb 13,10,'[sin eco]',13,10,'$'
msg_off:    defb 13,10,'TERM: fin.',13,10,'$'
msg_nolog:  defb 13,10,'TERM: log cortado, BDOS=$'

            end  start
